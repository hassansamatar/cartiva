@model Shipment
@using Cartiva.Domain.Enums
@using Cartiva.Domain.Extensions
@using Cartiva.Shared

@{
    ViewData["Title"] = "Edit Shipment";
}

<div class="container mt-4">
    <h2>Edit Shipment #@Model.Id</h2>
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">Tracking Number</label>
            <input type="text" name="trackingNumber" value="@Model.TrackingNumber" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Carrier</label>
            <select name="carrier" class="form-select">
                <option value="">-- Select --</option>
                <option value="@SD.CarrierPosten" selected="@(Model.Carrier == SD.CarrierPosten)">Posten Norge</option>
                <option value="@SD.CarrierBring" selected="@(Model.Carrier == SD.CarrierBring)">Bring</option>
                <option value="@SD.CarrierHelthjem" selected="@(Model.Carrier == SD.CarrierHelthjem)">Helthjem</option>
                <option value="@SD.CarrierDHL" selected="@(Model.Carrier == SD.CarrierDHL)">DHL Express</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Service</label>
            <input type="text" name="service" value="@Model.Service" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="shipmentStatus" class="form-select">
                <option value="@ShipmentStatus.PendingApproval" selected="@(Model.ShipmentStatus == ShipmentStatus.PendingApproval)">Pending Approval</option>
                <option value="@ShipmentStatus.Shipped" selected="@(Model.ShipmentStatus == ShipmentStatus.Shipped)">Shipped</option>
                <option value="@ShipmentStatus.Delivered" selected="@(Model.ShipmentStatus == ShipmentStatus.Delivered)">Delivered</option>
                <option value="@ShipmentStatus.Cancelled" selected="@(Model.ShipmentStatus == ShipmentStatus.Cancelled)">Cancelled</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </form>
</div>