@model IEnumerable<Cartiva.Domain.AccountsReceivableAdjustment>

@using Cartiva.Shared
@using Cartiva.Domain
@using Cartiva.Domain.Enums
@using System.Globalization

@{
    ViewData["Title"] = "AR Adjustments";
    var culture = CultureInfo.GetCultureInfo("nb-NO");
    var allAdjustments = Model.ToList();
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentCompanyId = ViewBag.CurrentCompanyId as int?;
    var currentFromDate = ViewBag.CurrentFromDate as string;
    var currentToDate = ViewBag.CurrentToDate as string;
    var companies = ViewBag.Companies as List<Company> ?? new List<Company>();

    var pendingCount = allAdjustments.Count(a => a.Status == ARAdjustmentStatus.Pending);
    var approvedCount = allAdjustments.Count(a => a.Status == ARAdjustmentStatus.Approved);
    var appliedCount = allAdjustments.Count(a => a.Status == ARAdjustmentStatus.Applied);
    var totalAmount = allAdjustments.Where(a => a.Status == ARAdjustmentStatus.Applied).Sum(a => Math.Abs(a.Amount));
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-calculator"></i> AR Adjustments Management</h2>
            @* Manual creation disabled - AR Adjustments created automatically from returns *@
        </div>

        <div class="row mb-4 g-3">
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-warning">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-clock"></i> Pending</h5>
                        <h3>@pendingCount</h3>
                        <p>Awaiting approval</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-info">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-check-circle"></i> Approved</h5>
                        <h3>@approvedCount</h3>
                        <p>Not yet applied to Stripe</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-success">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-check2-all"></i> Applied</h5>
                        <h3>@appliedCount</h3>
                        <p>Completed adjustments</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-primary">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-currency-exchange"></i> Total Applied</h5>
                        <h3>@totalAmount.ToString("N2", culture) NOK</h3>
                        <p>Total adjustments applied</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-section">
            <div class="section-header">
                <h3><i class="bi bi-table"></i> All AR Adjustments</h3>
            </div>

            <form method="get" class="row g-2 mb-3 px-3 pt-3">
                <div class="col-lg-3">
                    <input type="text"
                           name="search"
                           value="@currentSearch"
                           class="form-control"
                           placeholder="Search company, invoice, or reason" />
                </div>
                <div class="col-lg-2">
                    <select name="companyId" class="form-select">
                        <option value="">All Companies</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.Id" selected="@(currentCompanyId == company.Id)">@company.Name</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2">
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="@ARAdjustmentStatus.Pending" selected="@(currentStatus == ARAdjustmentStatus.Pending.ToString())">Pending</option>
                        <option value="@ARAdjustmentStatus.Approved" selected="@(currentStatus == ARAdjustmentStatus.Approved.ToString())">Approved</option>
                        <option value="@ARAdjustmentStatus.Applied" selected="@(currentStatus == ARAdjustmentStatus.Applied.ToString())">Applied</option>
                    </select>
                </div>
                <div class="col-lg-2">
                    <input type="date"
                           name="fromDate"
                           value="@currentFromDate"
                           class="form-control"
                           placeholder="From date" />
                </div>
                <div class="col-lg-2">
                    <input type="date"
                           name="toDate"
                           value="@currentToDate"
                           class="form-control"
                           placeholder="To date" />
                </div>
                <div class="col-lg-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>

            <div class="table-responsive">
                <table id="adjustmentsTable" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Date</th>
                            <th>Company</th>
                            <th>Invoice</th>
                            <th>Amount</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Stripe</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var adjustment in allAdjustments)
                        {
                            var statusClass = adjustment.Status switch
                            {
                                ARAdjustmentStatus.Pending => "warning",
                                ARAdjustmentStatus.Approved => "info",
                                ARAdjustmentStatus.Applied => "success",
                                _ => "secondary"
                            };

                            var isManual = adjustment.ReturnRequestId == 0;
                            <tr>
                                <td>@adjustment.Id</td>
                                <td>@adjustment.CreatedAt.ToString("dd.MM.yyyy", culture)</td>
                                <td>
                                    <a asp-controller="Company" asp-action="Details" asp-route-id="@adjustment.CompanyId">
                                        @adjustment.Company.Name
                                    </a>
                                </td>
                                <td>
                                    <a asp-controller="Invoice" asp-action="Details" asp-route-id="@adjustment.InvoiceId">
                                        @adjustment.Invoice.InvoiceNumber
                                    </a>
                                </td>
                                <td class="@(adjustment.Amount < 0 ? "text-danger" : "text-success")">
                                    @adjustment.Amount.ToString("N2", culture) @adjustment.Currency
                                </td>
                                <td>
                                    <span title="@adjustment.Reason">
                                        @(adjustment.Reason.Length > 50 ? adjustment.Reason.Substring(0, 50) + "..." : adjustment.Reason)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-@statusClass">@adjustment.Status</span>
                                </td>
                                <td>
                                    @if (adjustment.StripeCreditBalanceApplied)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Applied to Stripe"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle text-muted" title="Not applied"></i>
                                    }
                                </td>
                                <td>
                                    @if (isManual)
                                    {
                                        <span class="badge bg-warning">Manual</span>
                                    }
                                    else
                                    {
                                        <a asp-controller="Return" asp-action="Index" asp-route-id="@adjustment.ReturnRequestId" class="badge bg-primary">
                                            Return #@adjustment.ReturnRequestId
                                        </a>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@adjustment.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#adjustmentsTable').DataTable({
                responsive: true,
                order: [[1, 'desc']], // Sort by date descending
                pageLength: 25,
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ adjustments",
                    info: "Showing _START_ to _END_ of _TOTAL_ adjustments",
                    infoEmpty: "No adjustments found",
                    infoFiltered: "(filtered from _MAX_ total)",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        });
    </script>
}
