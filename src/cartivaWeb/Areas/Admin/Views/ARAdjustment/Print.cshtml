@model Cartiva.Domain.AccountsReceivableAdjustment

@using Cartiva.Domain.Enums
@using System.Globalization

@{
    ViewData["Title"] = $"AR Adjustment #{Model.Id} - Print";
    var culture = CultureInfo.GetCultureInfo("nb-NO");
    var isManual = Model.ReturnRequestId == 0;

    var statusClass = Model.Status switch
    {
        ARAdjustmentStatus.Pending => "warning",
        ARAdjustmentStatus.Approved => "info",
        ARAdjustmentStatus.Applied => "success",
        _ => "secondary"
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            /* Print-specific styles – no backgrounds, full black text, crisp borders */
            body {
                background: white;
                color: black;
                font-size: 10pt;
                margin: 1.5cm;
            }

            .container {
                max-width: 100%;
                padding: 0;
            }

            .card {
                border: 1px solid #ccc;
                margin-bottom: 1rem;
                break-inside: avoid;
            }

            .card-header {
                background-color: #f5f5f5 !important;
                color: black !important;
                border-bottom: 1px solid #ccc;
                font-weight: bold;
                padding: 0.5rem 1rem;
            }

            .card-body {
                padding: 1rem;
            }

            .badge {
                border: 1px solid #aaa;
                background: none !important;
                color: black !important;
                font-weight: normal;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th, td {
                padding: 0.3rem 0;
                vertical-align: top;
            }

            .border-top {
                border-top: 1px solid #aaa;
            }

            hr {
                margin: 1rem 0;
            }

            .no-print {
                display: none;
            }

            a {
                text-decoration: none;
                color: black;
            }

            .text-success, .text-danger, .text-warning {
                color: black !important;
            }

            .d-print-block {
                display: block !important;
            }

            .page-break {
                page-break-before: avoid;
                page-break-inside: avoid;
            }

            footer {
                font-size: 8pt;
                text-align: center;
                margin-top: 2rem;
                border-top: 1px solid #ccc;
                padding-top: 0.5rem;
            }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="text-center mb-4">
            <h2>AR Adjustment #@Model.Id</h2>
            <div>
                <span class="badge">@Model.Status</span>
                @if (isManual)
                {
                    <span class="badge">Manual Adjustment</span>
                }
                else
                {
                    <span class="badge">Return-Based</span>
                }
            </div>
            <hr />
        </div>

        <div class="row">
            <!-- Left column: details -->
            <div class="col-12 col-md-7">
                <div class="card">
                    <div class="card-header">Adjustment Information</div>
                    <div class="card-body">
                        <table>
                            <tr>
                                <th style="width: 30%">Company</th>
                                <td>@Model.Company.Name @(Model.Company.IsActive ? "(Active)" : "(Inactive)")</td>
                            </tr>
                            <tr>
                                <th>Invoice</th>
                                <td>@Model.Invoice.InvoiceNumber (@Model.Invoice.TotalAmount.ToString("N2", culture) @Model.Invoice.Currency)</td>
                            </tr>
                            <tr>
                                <th>Amount</th>
                                <td>
                                    <strong>@Model.Amount.ToString("N2", culture) @Model.Currency</strong>
                                    (@(Model.Amount < 0 ? "Reduces company balance" : "Increases company balance"))
                                </td>
                            </tr>
                            <tr>
                                <th>Reason</th>
                                <td>@Model.Reason</td>
                            </tr>
                            @if (!string.IsNullOrWhiteSpace(Model.Notes))
                            {
                                <tr>
                                    <th>Notes</th>
                                    <td>@Model.Notes</td>
                                </tr>
                            }
                            <tr>
                                <th>Created</th>
                                <td>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm", culture) @(!string.IsNullOrWhiteSpace(Model.CreatedByUserId) ? $"by {Model.CreatedByUserId}" : "")</td>
                            </tr>
                            @if (Model.AppliedAt.HasValue)
                            {
                                <tr>
                                    <th>Applied</th>
                                    <td>@Model.AppliedAt.Value.ToString("dd.MM.yyyy HH:mm", culture)</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">Stripe Integration</div>
                    <div class="card-body">
                        <table>
                            <tr>
                                <th style="width: 35%">Stripe Customer ID</th>
                                <td>@(string.IsNullOrWhiteSpace(Model.Company.StripeCustomerId) ? "Not configured" : Model.Company.StripeCustomerId)</td>
                            </tr>
                            <tr>
                                <th>Credit Balance Applied</th>
                                <td>@(Model.StripeCreditBalanceApplied ? "Yes" : "No")</td>
                            </tr>
                            @if (!string.IsNullOrWhiteSpace(Model.StripeCustomerBalanceReference))
                            {
                                <tr>
                                    <th>Stripe Transaction ID</th>
                                    <td>@Model.StripeCustomerBalanceReference</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right column: invoice impact -->
            <div class="col-12 col-md-5">
                <div class="card">
                    <div class="card-header">Invoice Impact</div>
                    <div class="card-body">
                        <table>
                            <tr>
                                <th>Invoice Total</th>
                                <td class="text-end">@Model.Invoice.TotalAmount.ToString("N2", culture) @Model.Currency</td>
                            </tr>
                            <tr>
                                <th>Paid</th>
                                <td class="text-end">-@Model.Invoice.TotalPaid.ToString("N2", culture)</td>
                            </tr>
                            <tr>
                                <th>Credit Notes</th>
                                <td class="text-end">-@Model.Invoice.TotalCredited.ToString("N2", culture)</td>
                            </tr>
                            <tr>
                                <th>AR Adjustments</th>
                                <td class="text-end">-@Model.Invoice.TotalARAdjustments.ToString("N2", culture)</td>
                            </tr>
                            <tr class="border-top">
                                <th><strong>Remaining</strong></th>
                                <td class="text-end">
                                    <strong>@Model.Invoice.RemainingAmount.ToString("N2", culture) @Model.Currency</strong>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Return reference if applicable -->
                @if (!isManual && Model.ReturnRequestId > 0)
                {
                    <div class="card mt-3">
                        <div class="card-header">Return Reference</div>
                        <div class="card-body">
                            <p>Return Request #@Model.ReturnRequestId</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Footer -->
        <footer>
            Generated on @DateTime.Now.ToString("dd.MM.yyyy HH:mm") | AR Adjustment ID: @Model.Id
        </footer>
    </div>

    <!-- Auto-print script (optional) – remove if you don't want immediate print dialog -->
    <script>
            window.onload = function () {
                window.print();
            };
    </script>
</body>
</html>