@model Company
@using Cartiva.Domain

@{
    ViewData["Title"] = "Delete Company";
    bool hasOrderHistory = ViewBag.HasOrderHistory ?? false;
    bool hasActiveUsers = ViewBag.HasActiveUsers ?? false;
    bool canDelete = ViewBag.CanDelete ?? true;
    var companyUsers = ViewBag.CompanyUsers as List<ApplicationUser> ?? new List<ApplicationUser>();
    int userCount = ViewBag.UserCount ?? 0;
    int activeUserCount = ViewBag.ActiveUserCount ?? 0;
}

<div class="card shadow border-0 my-4">
    <div class="card-header bg-danger bg-gradient py-3">
        <div class="text-center">
            <h2 class="text-white">
                <i class="bi bi-exclamation-triangle-fill"></i> Delete Company
            </h2>
        </div>
    </div>

    <div class="card-body p-4">
        @if (!canDelete)
        {
            <!-- Cannot Delete Alert - Company has order history or active users -->
            <div class="alert alert-danger mb-4">
                <div class="d-flex">
                    <div class="me-3">
                        <i class="bi bi-exclamation-octagon-fill fs-1"></i>
                    </div>
                    <div>
                        <h5 class="alert-heading">Cannot Delete Company</h5>
                        @if (hasOrderHistory && hasActiveUsers)
                        {
                            <p class="mb-2">
                                This company has <strong>order history</strong> and <strong>@activeUserCount active user(s)</strong> assigned to it.
                            </p>
                        }
                        else if (hasOrderHistory)
                        {
                            <p class="mb-2">
                                This company has <strong>order history</strong> associated with it.
                            </p>
                        }
                        else if (hasActiveUsers)
                        {
                            <p class="mb-2">
                                This company has <strong>@activeUserCount active user(s)</strong> assigned to it.
                            </p>
                        }
                        <p class="mb-0">
                            <strong>To delete this company, you must first:</strong>
                        </p>
                        <ul class="mb-0 mt-2">
                            @if (hasActiveUsers)
                            {
                                <li>Deactivate or reassign all users to another company</li>
                            }
                            @if (hasOrderHistory)
                            {
                                <li>Note: Companies with order history cannot be deleted for audit purposes. Consider deactivating instead.</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Confirmation Alert - Company can be deleted -->
            <div class="alert alert-warning mb-4">
                <div class="d-flex">
                    <div class="me-3">
                        <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                    </div>
                    <div>
                        <h5 class="alert-heading">Are you sure?</h5>
                        <p class="mb-0">
                            You are about to delete this company. This action cannot be undone.
                        </p>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-building me-2"></i>Company Details</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-3">Company Name</dt>
                            <dd class="col-sm-9">
                                <strong>@Model.Name</strong>
                            </dd>

                            <dt class="col-sm-3">Address</dt>
                            <dd class="col-sm-9">
                                @Model.StreetAddress<br />
                                @Model.PostalCode @Model.City
                                @if (!string.IsNullOrEmpty(Model.State))
                                {
                                    <text>, @Model.State</text>
                                }
                            </dd>

                            <dt class="col-sm-3">Phone</dt>
                            <dd class="col-sm-9">
                                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                {
                                    <a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a>
                                }
                                else
                                {
                                    <span class="text-muted">Not provided</span>
                                }
                            </dd>

                            <dt class="col-sm-3">Status</dt>
                            <dd class="col-sm-9">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-x-circle"></i> Inactive
                                    </span>
                                }
                            </dd>

                            <dt class="col-sm-3">Delete Status</dt>
                            <dd class="col-sm-9">
                                @if (canDelete)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Safe to delete
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-exclamation-circle"></i> Cannot delete
                                    </span>
                                    @if (hasOrderHistory)
                                    {
                                        <span class="badge bg-info ms-1">
                                            <i class="bi bi-receipt"></i> Has order history
                                        </span>
                                    }
                                    @if (hasActiveUsers)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">
                                            <i class="bi bi-people"></i> Has active users
                                        </span>
                                    }
                                }
                            </dd>
                        </dl>
                    </div>
                </div>

                <!-- Users List (if any) -->
                @if (userCount > 0)
                {
                    <div class="card mt-3">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-people me-2"></i>Associated Users (@userCount)
                                </h5>
                                <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Manage Users
                                </a>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in companyUsers.Take(5))
                                        {
                                            <tr>
                                                <td>@(user.Name ?? "—")</td>
                                                <td>@user.Email</td>
                                                <td>
                                                    @if (user.IsActive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Inactive</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                        @if (userCount > 5)
                                        {
                                            <tr>
                                                <td colspan="3" class="text-center text-muted">
                                                    <i class="bi bi-three-dots"></i> and @(userCount - 5) more users
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Summary Card -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Summary</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-2">
                            <strong>Company:</strong><br />
                            <span class="badge bg-primary">@Model.Name</span>
                        </p>
                        <p class="mb-2">
                            <strong>Status:</strong><br />
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </p>
                        <p class="mb-2">
                            <strong>Users:</strong><br />
                            <span class="badge bg-info">@userCount total</span>
                            @if (activeUserCount > 0)
                            {
                                <span class="badge bg-warning text-dark ms-1">@activeUserCount active</span>
                            }
                        </p>
                        <p class="mb-0">
                            <strong>Can Delete:</strong><br />
                            @if (canDelete)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Yes
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle"></i> No
                                </span>
                            }
                        </p>
                    </div>
                </div>

                @if (!canDelete)
                {
                    <div class="card mt-3 border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h6 class="mb-0"><i class="bi bi-lightbulb me-2"></i>Suggestion</h6>
                        </div>
                        <div class="card-body">
                            <p class="mb-2 small">
                                Since this company cannot be deleted, consider <strong>deactivating</strong> it instead.
                            </p>
                            <p class="mb-0 small text-muted">
                                Inactive companies cannot place new orders but their historical data is preserved.
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-4 d-flex gap-2">
            @if (canDelete)
            {
                <!-- When company can be deleted - show delete form -->
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete Company
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            }
            else
            {
                <!-- When company cannot be deleted - show manage users and back buttons -->
                <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-warning">
                    <i class="bi bi-people"></i> Manage Users
                </a>
                <a asp-action="Upsert" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-toggle-off"></i> Deactivate Company
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            }
        </div>
    </div>
</div>