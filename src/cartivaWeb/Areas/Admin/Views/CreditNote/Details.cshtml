@model Cartiva.Domain.CreditNote
@using Cartiva.Application.Extensions
@using Cartiva.Shared
@using System.Globalization

@{
    ViewData["Title"] = "Credit Note Details";
    var culture = CultureInfo.GetCultureInfo("nb-NO");
    var orderId = Model.OriginalInvoice?.OrderHeaderId ?? Model.ReturnRequest?.OrderDetail?.OrderHeaderId;
    var relatedReturnId = Model.ReturnRequestId;
}

<div class="container-fluid py-4" style="max-width: 900px;">
    <div class="container">
        <!-- Header with Title and Status -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Credit Note #@Model.CreditNoteNumber</h2>
            <div class="d-flex gap-2">
                <span class="badge @Model.Status.GetBadgeClass() fs-6">@Model.Status</span>
            </div>
        </div>

        <!-- Action Buttons (replacing DocumentActionBar) -->
        <div class="mb-3 d-flex gap-2">
            <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-secondary">
                <i class="bi bi-printer"></i> Print
            </a>
            <form asp-action="SendEmail" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-envelope"></i> Send Email
                </button>
            </form>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header bg-primary text-white">Credit Note Information</div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Type</dt>
                            <dd class="col-sm-8">@((Model.ReturnRequestId.HasValue ? "Return credit note" : "Cancellation / manual credit note"))</dd>
                            <dt class="col-sm-4">Customer</dt>
                            <dd class="col-sm-8">@Model.CustomerName</dd>
                            <dt class="col-sm-4">Reason</dt>
                            <dd class="col-sm-8">@Model.Reason</dd>
                            <dt class="col-sm-4">Currency</dt>
                            <dd class="col-sm-8">@Model.Currency</dd>
                            @if (!string.IsNullOrWhiteSpace(Model.CustomerAddress))
                            {
                                <dt class="col-sm-4">Address</dt>
                                <dd class="col-sm-8">@Model.CustomerAddress</dd>
                            }
                            @if (Model.ReturnRequestId.HasValue)
                            {
                                <dt class="col-sm-4">Return Request</dt>
                                <dd class="col-sm-8">
                                    <a asp-area="Admin" asp-controller="Return" asp-action="Index" asp-fragment="return-@Model.ReturnRequestId">#@Model.ReturnRequestId</a>
                                </dd>
                            }
                            @if (Model.OriginalInvoice?.OrderHeaderId != null)
                            {
                                <dt class="col-sm-4">Order</dt>
                                <dd class="col-sm-8">
                                    <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@Model.OriginalInvoice.OrderHeaderId">
                                        #@Model.OriginalInvoice.OrderHeaderId
                                    </a>
                                </dd>
                            }
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header bg-secondary text-white">Document Details</div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-5">Date</dt>
                            <dd class="col-sm-7">@Model.CreatedAt.ToString("dd.MM.yyyy")</dd>
                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7">@Model.Status</dd>
                            @if (!string.IsNullOrWhiteSpace(Model.ExternalRefundReference))
                            {
                                <dt class="col-sm-5">Refund Ref</dt>
                                <dd class="col-sm-7">@Model.ExternalRefundReference</dd>
                            }
                            @if (Model.OriginalInvoice != null)
                            {
                                <dt class="col-sm-5">Original Invoice</dt>
                                <dd class="col-sm-7">
                                    <a asp-area="Admin" asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.OriginalInvoiceId">
                                        @Model.OriginalInvoice.InvoiceNumber
                                    </a>
                                </dd>
                                <dt class="col-sm-5">Invoice Date</dt>
                                <dd class="col-sm-7">@Model.OriginalInvoice.IssueDate.ToString("dd.MM.yyyy")</dd>
                                <dt class="col-sm-5">Invoice Total</dt>
                                <dd class="col-sm-7">@Model.OriginalInvoice.TotalAmount.ToString("C", culture)</dd>
                            }
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- Credit Note Lines -->
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <strong>Credit Note Lines</strong>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Lines != null && Model.Lines.Any())
                        {
                            foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>@line.Description</td>
                                    <td class="text-center">@line.Quantity</td>
                                    <td class="text-end">@line.UnitPrice.ToString("C", culture)</td>
                                    <td class="text-end">@line.LineTotalAmount.ToString("C", culture)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">No credit note lines found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Totals -->
        <div class="card mt-3 shadow-sm">
            <div class="card-body text-end">
                <div>
                    <span class="me-3">Net:</span>
                    <strong>@Model.NetAmount.ToString("C", culture)</strong>
                </div>
                <div>
                    <span class="me-3">VAT:</span>
                    <strong>@Model.VatAmount.ToString("C", culture)</strong>
                </div>
                <div class="fs-5 mt-2">
                    <span class="me-3">Total:</span>
                    <strong class="text-success">
                        @Model.TotalAmount.ToString("C", culture)
                    </strong>
                </div>
            </div>
        </div>

        <!-- Bottom Navigation -->
        <div class="mt-3 d-flex gap-2">
            <a asp-area="Admin" asp-controller="CreditNote" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to Credit Notes
            </a>
            <a asp-area="Admin" asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.OriginalInvoiceId" class="btn btn-outline-primary">
                <i class="bi bi-receipt"></i> View Original Invoice
            </a>
            @if (orderId.HasValue)
            {
                <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@orderId.Value" class="btn btn-outline-dark">
                    <i class="bi bi-bag"></i> View Order
                </a>
            }
            @if (relatedReturnId.HasValue)
            {
                <a asp-area="Admin" asp-controller="Return" asp-action="Index" asp-fragment="return-@relatedReturnId" class="btn btn-outline-info">
                    <i class="bi bi-arrow-return-left"></i> View Return Queue
                </a>
            }
        </div>
    </div>
</div>