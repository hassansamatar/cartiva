@model Cartiva.Domain.CreditNote
@using Cartiva.Shared
@using System.Globalization

@{
    ViewData["Title"] = "Credit Note Details";
    var culture = CultureInfo.GetCultureInfo("nb-NO");
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Credit Note @Model.CreditNoteNumber</h3>

        <span class="badge @SD.GetCreditNoteStatusBadgeClass(Model.Status.ToString()) fs-6">
            @Model.Status
        </span>
    </div>

    @{
        var orderId = Model.OriginalInvoice?.OrderHeaderId
            ?? Model.ReturnRequest?.OrderDetail?.OrderHeaderId;
        var relatedReturnId = Model.ReturnRequestId;
        var noteType = relatedReturnId.HasValue ? "Return credit note" : "Cancellation / manual credit note";
    }

    <!-- HEADER INFO -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body">

            <div class="row">
                <div class="col-md-6">
                    <p class="mb-1"><strong>Type:</strong> @noteType</p>
                    <p class="mb-1"><strong>Customer:</strong> @Model.CustomerName</p>
                    <p class="mb-1"><strong>Reason:</strong> @Model.Reason</p>
                    <p class="mb-1"><strong>Currency:</strong> @Model.Currency</p>
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerAddress))
                    {
                        <p class="mb-1"><strong>Address:</strong> @Model.CustomerAddress</p>
                    }
                    @if (Model.ReturnRequestId.HasValue)
                    {
                        <p class="mb-1">
                            <strong>Return Request:</strong>
                            <a asp-area="Admin" asp-controller="Return" asp-action="Index" asp-fragment="return-@Model.ReturnRequestId">#@Model.ReturnRequestId</a>
                        </p>
                    }
                    @if (orderId.HasValue)
                    {
                        <p class="mb-1">
                            <strong>Order:</strong>
                            <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@orderId.Value">
                                #@orderId.Value
                            </a>
                        </p>
                    }
                </div>

                <div class="col-md-6 text-md-end">
                    <p class="mb-1"><strong>Date:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy")</p>
                    <p class="mb-1"><strong>Status:</strong> @Model.Status</p>
                    @if (!string.IsNullOrWhiteSpace(Model.ExternalRefundReference))
                    {
                        <p class="mb-1"><strong>Refund Ref:</strong> @Model.ExternalRefundReference</p>
                    }
                    @if (Model.OriginalInvoice != null)
                    {
                        <p class="mb-1">
                            <strong>Original Invoice:</strong>
                            <a asp-area="Admin" asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.OriginalInvoiceId">
                                @Model.OriginalInvoice.InvoiceNumber
                            </a>
                        </p>
                        <p class="mb-1">
                            <strong>Invoice Date:</strong>
                            @Model.OriginalInvoice.IssueDate.ToString("dd.MM.yyyy")
                        </p>
                        <p class="mb-1">
                            <strong>Invoice Total:</strong>
                            @Model.OriginalInvoice.TotalAmount.ToString("C", culture)
                        </p>
                    }
                    else
                    {
                        <p class="mb-1"><strong>Original Invoice ID:</strong> @Model.OriginalInvoiceId</p>
                    }
                </div>
            </div>

        </div>
    </div>

    <!-- LINES -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <strong>Credit Note Lines</strong>
        </div>

        <div class="card-body p-0">

            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Unit Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Lines != null && Model.Lines.Any())
                    {
                        foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>@line.Description</td>

                                <td class="text-center">
                                    @line.Quantity
                                </td>

                                <td class="text-end">
                                    @line.UnitPrice.ToString("C", culture)
                                </td>

                                <td class="text-end">
                                    @line.LineTotalAmount.ToString("C", culture)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">
                                No credit note lines found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

    <!-- TOTAL -->
    <div class="card mt-3 shadow-sm">
        <div class="card-body text-end">

            <div>
                <span class="me-3">Net:</span>
                <strong>@Model.NetAmount.ToString("C", culture)</strong>
            </div>

            <div>
                <span class="me-3">VAT:</span>
                <strong>@Model.VatAmount.ToString("C", culture)</strong>
            </div>

            <div class="fs-5 mt-2">
                <span class="me-3">Total:</span>
                <strong class="text-success">
                    @Model.TotalAmount.ToString("C", culture)
                </strong>
            </div>

        </div>
    </div>

    <!-- BACK BUTTON -->
    <div class="mt-3">
        <a asp-area="Admin" asp-controller="CreditNote" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Credit Notes
        </a>
        <a asp-area="Admin" asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.OriginalInvoiceId" class="btn btn-outline-primary">
            <i class="bi bi-receipt"></i> View Original Invoice
        </a>
        @if (orderId.HasValue)
        {
            <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@orderId.Value" class="btn btn-outline-dark">
                <i class="bi bi-bag"></i> View Order
            </a>
        }
        @if (relatedReturnId.HasValue)
        {
            <a asp-area="Admin" asp-controller="Return" asp-action="Index" asp-fragment="return-@relatedReturnId" class="btn btn-outline-info">
                <i class="bi bi-arrow-return-left"></i> View Return Queue
            </a>
        }
    </div>

</div>
