@model IEnumerable<Cartiva.Domain.CreditNote>

@using Cartiva.Shared
@using Cartiva.Domain
@using System.Globalization

@{
    ViewData["Title"] = "Credit Notes";
    var culture = CultureInfo.GetCultureInfo("nb-NO");
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Credit Notes</h3>
    </div>

    <!-- Filter UI (UI only for now) -->
    <form method="get" class="mb-3 d-flex gap-2">

        <input type="text"
               name="search"
               class="form-control w-25"
               placeholder="Search credit notes..." />

        <select name="status" class="form-select w-25">
            <option value="">All Status</option>
            <option value="@CreditNoteStatus.Draft">Draft</option>
            <option value="@CreditNoteStatus.Issued">Issued</option>
            <option value="@CreditNoteStatus.Booked">Booked</option>
            <option value="@CreditNoteStatus.Cancelled">Cancelled</option>
        </select>

        <button type="submit" class="btn btn-primary">
            Filter
        </button>
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">

            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Number</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th class="text-end">Total</th>
                        <th>Reason</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No credit notes found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CreditNoteNumber</td>

                                <td>
                                    <div class="fw-semibold">@item.CustomerName</div>
                                </td>

                                <td>
                                    <span class="badge @SD.GetCreditNoteStatusBadgeClass(item.Status.ToString())">
                                        @item.Status
                                    </span>
                                </td>

                                <td class="text-end">
                                    @item.TotalAmount.ToString("C", culture)
                                </td>

                                <td>
                                    @item.Reason
                                </td>

                                <td>
                                    @item.CreatedAt.ToString("dd.MM.yyyy")
                                </td>

                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>

        </div>
    </div>

</div>