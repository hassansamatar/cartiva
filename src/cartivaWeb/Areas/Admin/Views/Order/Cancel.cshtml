@model OrderHeader
@using Cartiva.Application.Extensions
@using Cartiva.Domain.Enums
@using Cartiva.Domain.Extensions
@using Cartiva.Shared
@using System.Globalization

@{
    ViewData["Title"] = "Cancel Order";
    var culture = CultureInfo.GetCultureInfo("nb-NO");
    var orderStatus = Model.OrderStatus ?? global::Cartiva.Domain.Enums.OrderStatus.Pending;
    var paymentStatus = Model.PaymentStatus ?? global::Cartiva.Domain.Enums.PaymentStatus.Pending;
}

<div class="container mt-4">
    <h2>Cancel Order #@Model.Id</h2>

    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i> This action cancels the order only. Shipment management remains separate.
    </div>

    <div class="card mb-3">
        <div class="card-header">Order Details</div>
        <div class="card-body">
            <p><strong>Customer:</strong> @Model.Name</p>
            <p><strong>Order Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy HH:mm")</p>
            <p><strong>Total:</strong> @Model.OrderTotal.ToString("C", culture)</p>
            <p><strong>Status:</strong> <span class="badge @orderStatus.GetBadgeClass()">@Model.OrderStatus</span></p>
            <p><strong>Payment:</strong> <span class="badge @paymentStatus.GetBadgeClass()">@Model.PaymentStatus</span></p>
        </div>
    </div>

    <form asp-action="Cancel" method="post">
        <input type="hidden" name="orderId" value="@Model.Id" />
        <div class="mb-3">
            <label class="form-label">Reason</label>
            <textarea name="reason" class="form-control" rows="3" placeholder="Provide a cancellation reason"></textarea>
        </div>
        <button type="submit" class="btn btn-danger">Confirm Order Cancel</button>
        <a asp-action="Index" class="btn btn-secondary">Go Back</a>
    </form>
</div>
