@model IEnumerable<OrderHeader>
@using System.Globalization
@using Cartiva.Application.Extensions
@using Cartiva.Domain.Enums
@using Cartiva.Domain.Extensions
@using Cartiva.Shared

@{
    ViewData["Title"] = "Order Management";
    var currentStatus = ViewBag.CurrentStatus as string;
    var invoiceByOrderId = ViewBag.InvoiceByOrderId as Dictionary<int, int> ?? new Dictionary<int, int>();
    var culture = CultureInfo.GetCultureInfo("nb-NO");
    var allOrders = Model.ToList();
    var pendingCount = allOrders.Count(o => o.OrderStatus == OrderStatus.Pending);
    var approvedCount = allOrders.Count(o => o.OrderStatus == OrderStatus.Approved || o.OrderStatus == OrderStatus.AwaitingShipmentApproval);
    var shippedCount = allOrders.Count(o => o.OrderStatus == OrderStatus.Shipped);
    var cancelledCount = allOrders.Count(o => o.OrderStatus == OrderStatus.Cancelled);
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <div class="container-fluid">
        <h2><i class="bi bi-bag-check"></i> Order Management</h2>

        <div class="row mb-4 g-3">
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-warning">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-hourglass-split"></i> Pending</h5>
                        <h3>@pendingCount</h3>
                        <p>Awaiting action</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-info">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-check2-square"></i> Approved</h5>
                        <h3>@approvedCount</h3>
                        <p>Ready for fulfillment</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-success">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-truck"></i> Shipped</h5>
                        <h3>@shippedCount</h3>
                        <p>In progress</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-danger">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-x-circle"></i> Cancelled</h5>
                        <h3>@cancelledCount</h3>
                        <p>Closed orders</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-section">
            <div class="section-header">
                <h3><i class="bi bi-table"></i> All Orders</h3>
                <div class="btn-group" role="group">
                    <a asp-action="Index" asp-route-status="" class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-dark" : "btn-outline-dark")">All</a>
                    <a asp-action="Index" asp-route-status="@OrderStatus.Pending" class="btn btn-sm @(currentStatus == nameof(OrderStatus.Pending) ? "btn-warning" : "btn-outline-warning")">Pending</a>
                    <a asp-action="Index" asp-route-status="@OrderStatus.AwaitingShipmentApproval" class="btn btn-sm @(currentStatus == nameof(OrderStatus.AwaitingShipmentApproval) ? "btn-info" : "btn-outline-info")">Awaiting Shipment</a>
                    <a asp-action="Index" asp-route-status="@OrderStatus.Shipped" class="btn btn-sm @(currentStatus == nameof(OrderStatus.Shipped) ? "btn-success" : "btn-outline-success")">Shipped</a>
                    <a asp-action="Index" asp-route-status="@OrderStatus.Cancelled" class="btn btn-sm @(currentStatus == nameof(OrderStatus.Cancelled) ? "btn-danger" : "btn-outline-danger")">Cancelled</a>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h4>No Orders Found</h4>
                    <p>There are no orders matching your filter.</p>
                </div>
            }
            else
            {
                <table id="ordersTable" class="table admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Customer</th>
                            <th>Order Date</th>
                            <th>Order Status</th>
                            <th>Payment Status</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var orderStatus = order.OrderStatus ?? global::Cartiva.Domain.Enums.OrderStatus.Pending;
                            var paymentStatus = order.PaymentStatus ?? global::Cartiva.Domain.Enums.PaymentStatus.Pending;
                            <tr>
                                <td><strong>#@order.Id</strong></td>
                                <td>@order.Name</td>
                                <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td><span class="badge-status @orderStatus.GetBadgeClass()">@order.OrderStatus</span></td>
                                <td>
                                    <span class="badge-status @paymentStatus.GetBadgeClass()">@order.PaymentStatus</span>
                                    @if (paymentStatus == global::Cartiva.Domain.Enums.PaymentStatus.Refunded)
                                    {
                                        <br />
                                        <a asp-area="Admin" asp-controller="CreditNote" asp-action="Index" asp-route-search="@($"{order.Id}")" class="small text-decoration-none">
                                            View credit note
                                        </a>
                                    }
                                </td>
                                <td><strong>@order.OrderTotal.ToString("C", culture)</strong></td>
                                <td class="action-buttons">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-action="Details" asp-route-orderId="@order.Id" class="btn btn-sm btn-info" title="View Order">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Print" asp-route-orderId="@order.Id" class="btn btn-sm btn-secondary" title="Print Order">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        <form asp-action="ResendEmail" asp-route-orderId="@order.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary" title="Resend Email">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>
                                        @if (order.Shipments.Any())
                                        {
                                            <a asp-area="Admin" asp-controller="Shipment" asp-action="Details" asp-route-id="@order.Shipments.OrderByDescending(s => s.Id).First().Id" class="btn btn-sm btn-outline-primary" title="View Shipment">
                                                <i class="bi bi-truck"></i>
                                            </a>
                                        }
                                        @if (invoiceByOrderId.TryGetValue(order.Id, out var invoiceId))
                                        {
                                            <a asp-area="Admin" asp-controller="Invoice" asp-action="Details" asp-route-id="@invoiceId" class="btn btn-sm btn-outline-secondary" title="View Invoice">
                                                <i class="bi bi-receipt"></i>
                                            </a>
                                        }
                                        @if (paymentStatus == global::Cartiva.Domain.Enums.PaymentStatus.Refunded)
                                        {
                                            <a asp-area="Admin" asp-controller="CreditNote" asp-action="Index" asp-route-orderId="@order.Id" asp-route-type="cancellation" class="btn btn-sm btn-outline-success" title="View Credit Notes">
                                                <i class="bi bi-receipt"></i>
                                            </a>
                                        }
                                        @if (orderStatus != global::Cartiva.Domain.Enums.OrderStatus.Cancelled)
                                        {
                                            <a asp-action="Cancel" asp-route-orderId="@order.Id" class="btn btn-sm btn-danger" title="Cancel Order">
                                                <i class="bi bi-x-lg"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            initAdminTable('#ordersTable', {
                order: [[0, 'desc']],
                columnDefs: [{ targets: [-1], orderable: false }]
            });
        });
    </script>
}
