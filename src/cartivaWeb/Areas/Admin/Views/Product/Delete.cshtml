@model Product
@using System.Globalization
@using Cartiva.Shared

@{
    ViewData["Title"] = "Delete Product";
    var culture = CultureInfo.GetCultureInfo("nb-NO");
    var hasVariants = Model.Variants != null && Model.Variants.Any();
    var variantCount = Model.Variants?.Count ?? 0;
    var totalValue = Model.Variants?.Sum(v => v.Price * v.Stock) ?? 0;
}

<div class="card shadow border-0 my-4">
    <div class="card-header bg-danger bg-gradient py-3">
        <div class="text-center">
            <h2 class="text-white">
                <i class="bi bi-exclamation-triangle-fill"></i> Delete Product
            </h2>
        </div>
    </div>

    <div class="card-body p-4">
        @if (hasVariants)
        {
            <!-- Cannot Delete Alert - Product has variants -->
            <div class="alert alert-danger mb-4">
                <div class="d-flex">
                    <div class="me-3">
                        <i class="bi bi-exclamation-octagon-fill fs-1"></i>
                    </div>
                    <div>
                        <h5 class="alert-heading">Cannot Delete Product</h5>
                        <p class="mb-2">
                            This product has <strong>@variantCount variant(s)</strong> assigned to it with a total inventory value of 
                            <strong>@totalValue.ToString("C", culture)</strong>.
                        </p>
                        <p class="mb-0">
                            <strong>To delete this product, you must first:</strong>
                        </p>
                        <ul class="mb-0 mt-2">
                            <li>Delete all variants associated with this product, or</li>
                            <li>Reassign the variants to another product</li>
                        </ul>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Confirmation Alert - Product can be deleted -->
            <div class="alert alert-warning mb-4">
                <div class="d-flex">
                    <div class="me-3">
                        <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                    </div>
                    <div>
                        <h5 class="alert-heading">Are you sure?</h5>
                        <p class="mb-0">
                            You are about to delete this product. This action cannot be undone.
                        </p>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-md-8">
                <dl class="row">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Brand</dt>
                    <dd class="col-sm-9">@Model.Brand</dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@Model.Description</dd>

                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">
                        @(Model.Category?.Name ?? "N/A")
                        @if (Model.Category?.DefaultSizeSystem != null)
                        {
                            <br />
                            <span class="badge bg-info mt-1">
                                <i class="bi @(Model.Category.DefaultSizeSystem.IconClass ?? "bi-tag")"></i>
                                @Model.Category.DefaultSizeSystem.Name (@Model.Category.DefaultSizeSystem.SizeType)
                            </span>
                            <br />
                            <small class="text-muted">@Model.Category.DefaultSizeSystem.Description</small>
                        }
                    </dd>

                    <dt class="col-sm-3">Variants Status</dt>
                    <dd class="col-sm-9">
                        @if (hasVariants)
                        {
                            <span class="badge bg-danger">
                                <i class="bi bi-exclamation-circle"></i> @variantCount variant(s) assigned
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle"></i> No variants - Safe to delete
                            </span>
                        }
                    </dd>

                    @if (hasVariants)
                    {
                        <dt class="col-sm-3">Total Value</dt>
                        <dd class="col-sm-9">
                            <strong class="text-primary">@totalValue.ToString("C", culture)</strong>
                        </dd>
                    }
                </dl>

                <!-- Variants List (if any) -->
                @if (hasVariants)
                {
                    <div class="mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="text-danger mb-0">
                                <i class="bi bi-list-ul"></i> Associated Variants (@variantCount)
                            </h5>
                            <a asp-action="VariantIndex" asp-route-productId="@Model.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i> Manage Variants
                            </a>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Color</th>
                                        <th>Size</th>
                                        <th>Size System</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var variant in Model.Variants.Take(5))
                                    {
                                        var variantValue = variant.Price * variant.Stock;
                                        <tr>
                                            <td>
                                                <span class="badge" style="background-color: @GetColorBadgeColor(variant.Color); color: @GetTextColor(variant.Color); padding: 0.5rem;">
                                                    <i class="bi bi-droplet me-1"></i> @variant.Color
                                                </span>
                                            </td>
                                            <td>
                                                @if (variant.SizeValue != null)
                                                {
                                                    <strong>@variant.SizeValue.DisplayText</strong>
                                                    @if (!string.IsNullOrEmpty(variant.SizeValue.Description))
                                                    {
                                                        <br />
                                                        <small class="text-muted">@variant.SizeValue.Description</small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">No Size</span>
                                                }
                                            </td>
                                            <td>
                                                @if (variant.SizeValue?.SizeSystem != null)
                                                {
                                                    <span class="badge bg-info">
                                                        <i class="bi @(variant.SizeValue.SizeSystem.IconClass ?? "bi-tag")"></i>
                                                        @variant.SizeValue.SizeSystem.Name
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">N/A</span>
                                                }
                                            </td>
                                            <td>@variant.Price.ToString("C", culture)</td>
                                            <td>
                                                @if (variant.Stock > 10)
                                                {
                                                    <span class="badge bg-success">@variant.Stock</span>
                                                }
                                                else if (variant.Stock > 0)
                                                {
                                                    <span class="badge bg-warning text-dark">@variant.Stock</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">0</span>
                                                }
                                            </td>
                                            <td>@variantValue.ToString("C", culture)</td>
                                        </tr>
                                    }
                                    @if (variantCount > 5)
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted">
                                                <i class="bi bi-three-dots"></i> and @(variantCount - 5) more variants
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="5" class="text-end"><strong>Total Value:</strong></td>
                                        <td><strong>@totalValue.ToString("C", culture)</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="card">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">Product Image</h6>
                        </div>
                        <div class="card-body">
                            <img src="@Model.ImageUrl"
                                 class="img-fluid rounded shadow"
                                 style="max-height:200px; object-fit: cover;" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="card">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">Product Image</h6>
                        </div>
                        <div class="card-body">
                            <div class="py-4">
                                <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
                                <p class="text-muted mt-2">No image available</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- Quick Stats Card -->
                <div class="card mt-3">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Summary</h6>
                    </div>
                    <div class="card-body text-start">
                        <p class="mb-2">
                            <strong>Product:</strong><br />
                            <span class="badge bg-primary">@Model.Name</span>
                        </p>
                        <p class="mb-2">
                            <strong>Category:</strong><br />
                            <span class="badge bg-secondary">@(Model.Category?.Name ?? "N/A")</span>
                        </p>
                        <p class="mb-2">
                            <strong>Status:</strong><br />
                            @if (hasVariants)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-exclamation-circle"></i> In Use (@variantCount variants)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> No variants
                                </span>
                            }
                        </p>
                        @if (hasVariants)
                        {
                            <p class="mb-0">
                                <strong>Total Value:</strong><br />
                                <span class="text-primary fw-bold">@totalValue.ToString("C", culture)</span>
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="mt-4 d-flex gap-2">
            @if (hasVariants)
            {
                <!-- When product has variants - only show back button and manage variants link -->
                <a asp-action="VariantIndex" asp-route-productId="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-boxes"></i> Manage Variants
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            }
            else
            {
                <!-- When product has no variants - show delete form -->
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete Product
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancel
                </a>
            }
        </div>
    </div>
</div>

@functions {
    public string GetColorBadgeColor(string color)
    {
        return color?.ToLower() switch
        {
            "red" => "#dc3545",
            "blue" => "#0d6efd",
            "green" => "#198754",
            "black" => "#212529",
            "white" => "#ffffff",
            "yellow" => "#ffc107",
            "purple" => "#6f42c1",
            "orange" => "#fd7e14",
            "brown" => "#795548",
            "navy" => "#001f3f",
            "gray" or "grey" => "#6c757d",
            _ => "#6c757d"
        };
    }

    public string GetTextColor(string color)
    {
        return color?.ToLower() switch
        {
            "white" or "yellow" or "lightgray" or "lightgrey" => "#000000",
            _ => "#ffffff"
        };
    }
}
}