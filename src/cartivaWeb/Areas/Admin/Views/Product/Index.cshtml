@model IEnumerable<Product>

@{
    ViewData["Title"] = "Product Management";

    var totalProducts = Model?.Count() ?? 0;
    var productsWithVariants = Model?.Count(p => p.Variants != null && p.Variants.Any()) ?? 0;
    var productsWithoutVariants = Model?.Count(p => p.Variants == null || !p.Variants.Any()) ?? 0;
    var totalVariants = Model?.Sum(p => p.Variants?.Count ?? 0) ?? 0;
    var lowStockVariants = Model?.Sum(p => p.Variants?.Count(v => v.Stock <= 5) ?? 0) ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <div class="container-fluid">

        <h2><i class="bi bi-box-seam"></i> Product Management</h2>

        <!-- Summary Cards -->
        <div class="row mb-4 g-3">
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-primary">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-box-seam"></i> Total Products</h5>
                        <h3>@totalProducts</h3>
                        <p>Registered products</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-success">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-check-circle"></i> With Variants</h5>
                        <h3>@productsWithVariants</h3>
                        <p>Products with variants</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-warning">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-exclamation-triangle"></i> Without Variants</h5>
                        <h3>@productsWithoutVariants</h3>
                        <p>Need variants added</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-danger">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-graph-down"></i> Low Stock</h5>
                        <h3>@lowStockVariants</h3>
                        <p>Variants with ≤5 units</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Table Section -->
        <div class="admin-section">
            <div class="section-header">
                <h3><i class="bi bi-table"></i> All Products</h3>
                <a asp-action="Upsert" class="btn btn-create">
                    <i class="bi bi-plus-circle me-1"></i> Add Product
                </a>
            </div>

            @if (Model != null && Model.Any())
            {
                <table id="productsTable" class="table admin-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Brand</th>
                            <th>Category</th>
                            <th>Size System</th>
                            <th>Variants</th>
                            <th style="width: 30%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            var variantCount = product.Variants?.Count ?? 0;
                            var rowClass = variantCount == 0 ? "row-warning" : "";

                            <tr class="@rowClass">
                                <td>
                                    <span class="fw-600">
                                        <i class="bi bi-tag text-primary me-1"></i>@product.Name
                                    </span>
                                </td>
                                <td>@product.Brand</td>
                                <td>
                                    <span class="badge bg-light text-dark">
                                        <i class="bi bi-folder me-1"></i>@(product.Category?.Name ?? "N/A")
                                    </span>
                                </td>
                                <td>
                                    @if (product.Category?.DefaultSizeSystem != null)
                                    {
                                        <div class="d-flex align-items-center">
                                            <i class="bi @(product.Category.DefaultSizeSystem.IconClass ?? "bi-tag") me-2 text-info"></i>
                                            <span class="badge bg-info" data-bs-toggle="tooltip" title="@product.Category.DefaultSizeSystem.Description">
                                                @product.Category.DefaultSizeSystem.Name
                                            </span>
                                            <small class="ms-1 text-muted">(@product.Category.DefaultSizeSystem.SizeType)</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-dash"></i> No size system
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (product.Variants != null && product.Variants.Any())
                                    {
                                        <span class="badge bg-success">@product.Variants.Count</span>
                                        <small class="d-block text-muted mt-1">
                                            @{
                                                var firstVariant = product.Variants.FirstOrDefault();
                                                if (firstVariant?.SizeValue?.SizeSystem != null)
                                                {
                                                    <span><i class="bi bi-rulers"></i> @firstVariant.SizeValue.SizeSystem.SizeType</span>
                                                }
                                                else if (product.Category?.DefaultSizeSystem == null)
                                                {
                                                    <span class="text-muted"><i class="bi bi-dash"></i> No sizes</span>
                                                }
                                            }
                                        </small>
                                    }
                                    else if (product.Category?.DefaultSizeSystem != null)
                                    {
                                        <span class="badge bg-warning text-dark">0</span>
                                        <small class="d-block text-muted mt-1">
                                            <i class="bi bi-exclamation-circle"></i> No variants
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">—</span>
                                        <small class="d-block text-muted mt-1">
                                            <i class="bi bi-box"></i> Accessory
                                        </small>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Upsert" asp-route-id="@product.Id" class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-danger btn-sm">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                        <a asp-action="VariantIndex" asp-route-productId="@product.Id" class="btn btn-info btn-sm">
                                            <i class="bi bi-list"></i> Variants
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-box-seam"></i>
                    <h4>No products found</h4>
                    <p>Create your first product to get started.</p>
                    <a asp-action="Upsert" class="btn btn-create mt-3">
                        <i class="bi bi-plus-circle me-1"></i> Add Product
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            // Initialize Products DataTable
            initAdminTable('#productsTable', {
                order: [[0, 'asc']], // Sort by product name ascending
                columnDefs: [
                    { targets: [-1], orderable: false } // Disable sorting on actions column
                ]
            });

            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}