@model List<ReturnRequest>

@using Cartiva.Domain.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Return Management";
    var pendingCount = Model.Count(r => r.Status == ReturnStatus.Pending);
    var approvedCount = Model.Count(r => r.Status == ReturnStatus.Approved);
    var resolvedCount = Model.Count(r => r.Status == ReturnStatus.Refunded || r.Status == ReturnStatus.Rejected);
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-arrow-return-left"></i> Return Management
            </h4>
            <div>
                @if (pendingCount > 0)
                {
                    <span class="badge bg-warning text-dark">@pendingCount pending</span>
                }
                @if (approvedCount > 0)
                {
                    <span class="badge bg-info">@approvedCount approved</span>
                }
            </div>
        </div>

        <div class="card-body">
            <ul class="nav nav-tabs mb-3" id="returnTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending"
                            type="button" role="tab">
                        Pending <span class="badge bg-warning text-dark ms-1">@pendingCount</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="approved-tab" data-bs-toggle="tab" data-bs-target="#approved"
                            type="button" role="tab">
                        Approved <span class="badge bg-info ms-1">@approvedCount</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="resolved-tab" data-bs-toggle="tab" data-bs-target="#resolved"
                            type="button" role="tab">
                        Resolved <span class="badge bg-secondary ms-1">@resolvedCount</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- PENDING -->
                <div class="tab-pane fade show active" id="pending" role="tabpanel">
                    @{
                        var pendingReturns = Model.Where(r => r.Status == ReturnStatus.Pending).ToList();
                    }
                    @if (!pendingReturns.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-check-circle" style="font-size: 3rem;"></i>
                            <p class="mt-2">No pending returns.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var ret in pendingReturns)
                        {
                            @await Html.PartialAsync("_ReturnCard", ret)
                            // ✅ single item
                        }
                    }
                </div>

                <!-- APPROVED -->
                <div class="tab-pane fade" id="approved" role="tabpanel">
                    @{
                        var approvedReturns = Model.Where(r => r.Status == ReturnStatus.Approved).ToList();
                    }
                    @if (!approvedReturns.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-check-all" style="font-size: 3rem;"></i>
                            <p class="mt-2">No approved returns awaiting action.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var ret in approvedReturns)
                        {
                            @await Html.PartialAsync("_ReturnCard", ret)
                            // ✅ single item
                        }
                    }
                </div>

                <!-- RESOLVED -->
                <div class="tab-pane fade" id="resolved" role="tabpanel">
                    @{
                        var resolvedReturns = Model.Where(r => r.Status == ReturnStatus.Refunded || r.Status == ReturnStatus.Rejected).ToList();
                    }
                    @if (!resolvedReturns.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-archive" style="font-size: 3rem;"></i>
                            <p class="mt-2">No resolved returns.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var ret in resolvedReturns)
                        {
                            @await Html.PartialAsync("_ReturnCard", ret)
                            // ✅ single item
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>