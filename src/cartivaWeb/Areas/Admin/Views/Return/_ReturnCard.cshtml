@model ReturnRequest
@using Cartiva.Application.Extensions
@using Cartiva.Domain.Enums
@using Cartiva.Domain.Extensions
@using Cartiva.Shared
@using System.Globalization

@{
    var culture = CultureInfo.GetCultureInfo("nb-NO");
    var productName = Model.OrderDetail?.ProductVariant?.Product?.Name ?? "Product";
    var color = Model.OrderDetail?.ProductVariant?.Color;
    var orderId = Model.OrderDetail?.OrderHeaderId;
    var refundAmount = Model.RefundAmount ?? (Model.OrderDetail.Price * Model.Quantity);
    var returnStatus = Model.Status;

    // Determine if this is a company order and what type
    var isCompanyOrder = Model.OrderDetail?.OrderHeader?.ApplicationUser?.CompanyId != null;
    var company = Model.OrderDetail?.OrderHeader?.ApplicationUser?.Company;
    var paymentStatus = Model.OrderDetail?.OrderHeader?.PaymentStatus ?? PaymentStatus.Pending;
    var isCompanyActive = company?.IsActive ?? false;

    // Company with deferred payment → AR Adjustment
    var useARAdjustment = isCompanyOrder && isCompanyActive && 
                          (paymentStatus == PaymentStatus.Deferred || paymentStatus == PaymentStatus.Pending);

    // Company with upfront payment OR individual → Credit Note + Refund
    var useCreditNote = !useARAdjustment;
}

<div id="return-@Model.Id" class="card mb-3 shadow-sm">
    <div class="card-body">
        <div class="row">

            <!-- ITEM INFO -->
            <div class="col-md-4">
                @* Order ID - Prominent for easy identification *@
                <div class="mb-2">
                    <span class="badge bg-primary fs-6">
                        <i class="bi bi-bag"></i> Order #@orderId
                    </span>
                    <span class="badge bg-dark ms-1">
                        Return #@Model.Id
                    </span>
                </div>

                <h6 class="mb-1">@productName</h6>

                <span class="badge bg-secondary">@color</span>
                <span class="text-muted small ms-1">× @Model.Quantity</span>

                @* Company & Payment Type Indicators *@
                @if (isCompanyOrder && company != null)
                {
                    <div class="mt-2">
                        <span class="badge bg-info">
                            <i class="bi bi-building"></i> @company.Name
                        </span>
                        @if (useARAdjustment)
                        {
                            <span class="badge bg-warning text-dark" title="Deferred payment - Will create AR Adjustment on approval">
                                <i class="bi bi-calculator"></i> AR Adjustment
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success" title="Paid upfront - Will use Credit Note + Refund">
                                <i class="bi bi-file-earmark-text"></i> Credit Note
                            </span>
                        }
                    </div>
                }

                <div class="mt-2">
                    <a asp-area="Admin"
                       asp-controller="Order"
                       asp-action="Details"
                       asp-route-orderId="@orderId"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-bag"></i> View Order
                    </a>

                    @* Show AR Adjustment link ONLY if company with deferred payment *@
                    @if (useARAdjustment && isCompanyOrder)
                    {
                        var companyId = Model.OrderDetail.OrderHeader.ApplicationUser.CompanyId.Value;
                        <a asp-area="Admin"
                           asp-controller="ARAdjustment"
                           asp-action="Index"
                           asp-route-companyId="@companyId"
                           asp-route-search="@Model.Id"
                           class="btn btn-sm btn-outline-info"
                           title="View AR Adjustments for this company">
                            <i class="bi bi-calculator"></i> View AR Adjustments
                        </a>
                    }

                    @* Show Credit Note link ONLY if paid upfront *@
                    @if (useCreditNote && (returnStatus == ReturnStatus.Approved || returnStatus == ReturnStatus.Refunded))
                    {
                        <a asp-area="Admin"
                           asp-controller="CreditNote"
                           asp-action="Index"
                           asp-route-search="@Model.Id"
                           class="btn btn-sm btn-outline-primary"
                           title="View Credit Note">
                            <i class="bi bi-file-earmark-text"></i> Credit Note
                        </a>
                    }
                </div>

                <div class="mt-1">
                    <i class="bi bi-person me-1"></i>
                    <small>
                        @(Model.ApplicationUser?.Name ?? Model.ApplicationUser?.Email ?? "Customer")
                    </small>
                </div>
            </div>

            <!-- RETURN DETAILS -->
            <div class="col-md-4">
                <div class="mb-1">
                    <span class="badge bg-light text-dark border">@Model.Reason</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p class="small text-muted mb-1">@Model.Description</p>
                }

                <small class="text-muted">
                    <i class="bi bi-calendar"></i>
                    @Model.RequestDate.ToString("dd MMM yyyy HH:mm")
                </small>

                @* Show workflow instruction ONLY in Approved stage *@
                @if (returnStatus == ReturnStatus.Approved)
                {
                    <div class="alert alert-warning alert-sm mt-2 mb-0 py-1 px-2">
                        @if (useARAdjustment)
                        {
                            <small>
                                <i class="bi bi-arrow-right"></i>
                                <strong>Action Required:</strong> 
                                Apply AR Adjustment to complete.
                            </small>
                        }
                        else
                        {
                            <small>
                                <i class="bi bi-arrow-right"></i>
                                <strong>Action Required:</strong> 
                                Process refund to complete.
                            </small>
                        }
                    </div>
                }
            </div>

            <!-- STATUS & ACTIONS -->
            <div class="col-md-4 text-end">

                <div class="mb-2">
                    <span class="badge @returnStatus.GetBadgeClass() fs-6">
                        @Model.Status
                    </span>

                    <div class="fw-bold mt-1">
                        @if (useARAdjustment && returnStatus == ReturnStatus.Refunded)
                        {
                            <span class="text-success">
                                @refundAmount.ToString("C", culture)
                                <small class="d-block text-muted fw-normal" style="font-size: 0.75rem;">Balance Adjustment</small>
                            </span>
                        }
                        else
                        {
                            @refundAmount.ToString("C", culture)
                        }
                    </div>
                </div>

                @if (returnStatus == ReturnStatus.Pending)
                {
                    @* PENDING: Show Approve/Reject buttons *@
                    <div class="d-flex justify-content-end gap-1 flex-wrap">

                        <form asp-area="Admin"
                              asp-controller="Return"
                              asp-action="Approve"
                              asp-route-id="@Model.Id"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-success">
                                <i class="bi bi-check-lg"></i> Approve
                            </button>
                        </form>

                        <form asp-area="Admin"
                              asp-controller="Return"
                              asp-action="Reject"
                              asp-route-id="@Model.Id"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-x-lg"></i> Reject
                            </button>
                        </form>

                    </div>
                }
                else if (returnStatus == ReturnStatus.Approved)
                {
                    @* APPROVED: Show action buttons based on type *@

                    @if (useARAdjustment)
                    {
                        @* Company with deferred payment - AR Adjustment created, needs application *@
                        <div class="alert alert-info alert-sm mb-2 py-2">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-info-circle-fill text-info fs-4 me-2"></i>
                                <div>
                                    <small class="d-block">
                                        <strong>AR Adjustment Created</strong>
                                    </small>
                                    <small class="text-muted d-block">
                                        Ready to apply to company balance.
                                    </small>
                                </div>
                            </div>
                        </div>

                        @* Apply AR Adjustment button *@
                        <form asp-area="Admin"
                              asp-controller="Return"
                              asp-action="ApplyARAdjustment"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="btn-swal-confirm-form"
                              data-swal-title="Apply AR Adjustment?"
                              data-swal-text="This will finalize the balance adjustment for the company.">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-sm btn-success w-100">
                                <i class="bi bi-calculator"></i> Apply AR Adjustment
                            </button>
                        </form>
                    }
                    else
                    {
                        @* Individual or company paid upfront - Credit Note created, needs refund *@
                        <div class="alert alert-info alert-sm mb-2 py-2">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-info-circle-fill text-info fs-4 me-2"></i>
                                <div>
                                    <small class="d-block">
                                        <strong>Credit Note Created</strong>
                                    </small>
                                    <small class="text-muted d-block">
                                        Ready for refund processing.
                                    </small>
                                </div>
                            </div>
                        </div>

                        @* Process Refund button *@
                        <form asp-area="Admin"
                              asp-controller="Return"
                              asp-action="Refund"
                              asp-route-id="@Model.Id"
                              method="post"
                              class="btn-swal-confirm-form"
                              data-swal-title="Process refund of @refundAmount.ToString("C", culture)?"
                              data-swal-text="This will issue a Stripe refund to the customer.">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-sm btn-success w-100">
                                <i class="bi bi-credit-card"></i> Process Refund
                            </button>
                        </form>
                    }
                }
                else
                {
                    @* RESOLVED: Show completion info - Different message for AR vs Refund *@
                    <div class="alert alert-success alert-sm mb-2 py-2">
                        <div class="text-center">
                            <i class="bi bi-check-circle-fill text-success fs-4"></i>
                            <div class="mt-1">
                                @if (useARAdjustment)
                                {
                                    <small class="d-block">
                                        <strong>Balance Adjusted</strong>
                                    </small>
                                    <small class="text-muted d-block">
                                        AR Adjustment Applied
                                    </small>
                                }
                                else
                                {
                                    <small class="d-block">
                                        <strong>Refunded</strong>
                                    </small>
                                    <small class="text-muted d-block">
                                        Payment Returned
                                    </small>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.AdminNote))
                    {
                        <small class="text-muted d-block mt-2">
                            <i class="bi bi-chat-dots"></i> @Model.AdminNote
                        </small>
                    }

                    @if (Model.RefundDate.HasValue)
                    {
                        <small class="text-muted d-block">
                            @if (useARAdjustment)
                            {
                                <i class="bi bi-calculator"></i> @("Adjusted: " + Model.RefundDate.Value.ToString("dd MMM yyyy"))
                            }
                            else
                            {
                                <i class="bi bi-calendar-check"></i> @("Refunded: " + Model.RefundDate.Value.ToString("dd MMM yyyy"))
                            }
                        </small>
                    }

                    @if (!string.IsNullOrEmpty(Model.RefundId))
                    {
                        <small class="text-muted d-block">
                            <i class="bi bi-credit-card"></i> Stripe: @Model.RefundId
                        </small>
                    }
                }

            </div>
        </div>
    </div>
</div>
