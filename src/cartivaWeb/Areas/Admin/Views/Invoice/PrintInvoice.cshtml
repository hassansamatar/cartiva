@model Cartiva.Domain.OrderHeader
@using System.Globalization
@using Cartiva.Shared
@{
    Layout = null;
    var culture = CultureInfo.GetCultureInfo("nb-NO");
    var bankAccount = ViewBag.BankAccount as string;
    var kid = ViewBag.KID as string;
    var contact = ViewBag.CartivaContact as dynamic;

    // Calculate VAT breakdown
    var subtotalExVat = Model.SubtotalExVat > 0 ? Model.SubtotalExVat : Model.OrderTotal / 1.25m;
    var totalVat = Model.TotalVatAmount > 0 ? Model.TotalVatAmount : Model.OrderTotal - subtotalExVat;
    var hasDiscount = Model.TotalDiscountAmount > 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice #@Model.Id</title>
    <style>
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 40px;
            color: #333;
            font-size: 14px;
        }

        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            border: 1px solid #ddd;
            padding: 30px;
            border-radius: 8px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
            border-bottom: 2px solid #2c3e50;
            padding-bottom: 20px;
        }

        .header-left {
            flex: 1;
        }

        .header-right {
            text-align: right;
        }

        .invoice-title {
            font-size: 28px;
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .invoice-number {
            font-size: 16px;
            color: #7f8c8d;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        .info-box {
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .info-box h4 {
            margin: 0 0 10px 0;
            color: #2c3e50;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .info-box p {
            margin: 5px 0;
            line-height: 1.6;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        th {
            background-color: #2c3e50;
            color: white;
            padding: 12px 8px;
            text-align: left;
            font-weight: 500;
        }

        td {
            border-bottom: 1px solid #ddd;
            padding: 12px 8px;
        }

        .text-right {
            text-align: right;
        }

        .totals-section {
            display: flex;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .totals-table {
            width: 320px;
        }

        .totals-table td {
            padding: 8px;
            border: none;
        }

        .totals-table .total-row {
            font-weight: bold;
            font-size: 18px;
            border-top: 2px solid #2c3e50;
        }

        .totals-table .vat-row {
            color: #7f8c8d;
        }

        .discount-row {
            color: #e74c3c;
        }

        .payment-details {
            margin-top: 30px;
            padding: 20px;
            background: #f0f7ff;
            border-left: 4px solid #3498db;
            border-radius: 4px;
        }

        .payment-details h4 {
            margin: 0 0 15px 0;
            color: #2c3e50;
        }

        .payment-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .payment-item {
            display: flex;
            justify-content: space-between;
        }

        .payment-item label {
            font-weight: 500;
            color: #7f8c8d;
        }

        .payment-item span {
            font-weight: bold;
        }

        .kid-number {
            font-family: 'Courier New', monospace;
            font-size: 18px;
            letter-spacing: 2px;
            background: #fff;
            padding: 8px 12px;
            border-radius: 4px;
            border: 1px dashed #3498db;
        }

        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #ddd;
            font-size: 12px;
            text-align: center;
            color: #7f8c8d;
        }

        @@media print {
            body {
                margin: 0;
            }
            .no-print {
                display: none;
            }
            .invoice-container {
                border: none;
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <div class="header">
            <div class="header-left">
                <div class="invoice-title">FAKTURA / INVOICE</div>
                <div class="invoice-number">Order #@Model.Id</div>
            </div>
            <div class="header-right">
                <strong>@contact?.Name</strong><br />
                @contact?.Address<br />
                Org.nr: @contact?.OrgNumber<br />
                Tel: @contact?.Phone<br />
                @contact?.Email
            </div>
        </div>

        <div class="info-grid">
            <div class="info-box">
                <h4>Faktureres til / Bill To</h4>
                <p><strong>@(Model.ApplicationUser?.Company?.Name ?? Model.Name)</strong></p>
                <p>@Model.StreetAddress</p>
                <p>@Model.PostalCode @Model.City</p>
                <p>@Model.Country</p>
                <p>@Model.ApplicationUser?.Email</p>
            </div>
            <div class="info-box">
                <h4>Fakturadetaljer / Invoice Details</h4>
                <p><strong>Fakturadato:</strong> @Model.OrderDate.ToString("dd.MM.yyyy")</p>
                <p><strong>Forfallsdato:</strong> @Model.PaymentDueDate?.ToString("dd.MM.yyyy")</p>
                <p><strong>Ordre #:</strong> @Model.Id</p>
                <p><strong>Valuta:</strong> @(Model.Currency ?? "NOK")</p>
            </div>
        </div>

        <!-- Order details with VAT breakdown -->
        <table>
            <thead>
                <tr>
                    <th style="width: 40%">Produkt / Product</th>
                    <th class="text-right" style="width: 10%">Antall</th>
                    <th class="text-right" style="width: 15%">Pris eks. MVA</th>
                    <th class="text-right" style="width: 10%">MVA %</th>
                    <th class="text-right" style="width: 12%">MVA</th>
                    <th class="text-right" style="width: 13%">Sum inkl.</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderDetails)
                {
                    var lineExVat = item.PriceExVat > 0 ? item.PriceExVat : item.Price / 1.25m;
                    var lineVatRate = item.VatRate > 0 ? item.VatRate : 25.00m;
                    var lineVatAmount = lineExVat * (lineVatRate / 100m);
                    var lineTotal = (lineExVat + lineVatAmount) * item.Count;
                    var lineDiscount = item.UnitDiscountAmount * item.Count;

                    <tr>
                        <td>
                            @(item.ProductName ?? item.ProductVariant?.Product?.Name ?? "Product")
                            <br /><small style="color: #7f8c8d;">@(item.VariantDescription ?? $"{item.ProductVariant?.Color}")</small>
                            @if (item.HasDiscount)
                            {
                                <br /><small class="discount-row">Rabatt: -@lineDiscount.ToString("C", culture)</small>
                            }
                        </td>
                        <td class="text-right">@item.Count</td>
                        <td class="text-right">@lineExVat.ToString("N2", culture)</td>
                        <td class="text-right">@lineVatRate.ToString("N0")%</td>
                        <td class="text-right">@(lineVatAmount * item.Count).ToString("N2", culture)</td>
                        <td class="text-right">@item.LineTotalIncVat.ToString("N2", culture)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="totals-section">
            <table class="totals-table">
                @if (hasDiscount)
                {
                    <tr>
                        <td>Subtotal før rabatt:</td>
                        <td class="text-right">@((subtotalExVat + Model.TotalDiscountAmount / 1.25m).ToString("C", culture))</td>
                    </tr>
                    <tr class="discount-row">
                        <td>Rabatt:</td>
                        <td class="text-right">-@Model.TotalDiscountAmount.ToString("C", culture)</td>
                    </tr>
                }
                <tr>
                    <td>Sum eks. MVA:</td>
                    <td class="text-right">@subtotalExVat.ToString("C", culture)</td>
                </tr>
                <tr class="vat-row">
                    <td>MVA (25%):</td>
                    <td class="text-right">@totalVat.ToString("C", culture)</td>
                </tr>
                <tr class="total-row">
                    <td>Totalt å betale:</td>
                    <td class="text-right">@Model.OrderTotal.ToString("C", culture)</td>
                </tr>
            </table>
        </div>

        <!-- Norwegian payment details -->
        <div class="payment-details">
            <h4>Betalingsinformasjon / Payment Information</h4>
            <div class="payment-grid">
                <div class="payment-item">
                    <label>Forfallsdato:</label>
                    <span>@Model.PaymentDueDate?.ToString("dd.MM.yyyy")</span>
                </div>
                <div class="payment-item">
                    <label>Beløp:</label>
                    <span>@Model.OrderTotal.ToString("C", culture)</span>
                </div>
                <div class="payment-item">
                    <label>Kontonummer:</label>
                    <span>@bankAccount</span>
                </div>
                <div class="payment-item">
                    <label>KID-nummer:</label>
                    <span class="kid-number">@kid</span>
                </div>
            </div>
            <p style="margin-top: 15px; font-style: italic; color: #7f8c8d;">
                Vennligst bruk KID-nummer ved betaling for korrekt registrering.
            </p>
        </div>

        <div class="footer">
            <p>Dette er en elektronisk faktura – ingen fysisk kopi sendes.</p>
            <p>Ved forsinket betaling kan det påløpe renter og inkassokostnader iht. norsk lov.</p>
            <p style="margin-top: 10px;">
                <strong>@contact?.Name</strong> | Org.nr: @contact?.OrgNumber | @contact?.Email
            </p>
        </div>

        <div class="no-print" style="text-align: center; margin-top: 30px;">
            <button onclick="window.print()" style="padding: 10px 30px; font-size: 16px; background: #3498db; color: white; border: none; border-radius: 5px; cursor: pointer; margin-right: 10px;">
                Print / Save PDF
            </button>
            <button onclick="window.close()" style="padding: 10px 30px; font-size: 16px; background: #95a5a6; color: white; border: none; border-radius: 5px; cursor: pointer;">
                Close
            </button>
        </div>
    </div>
</body>
</html>
</html>