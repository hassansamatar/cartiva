@model Cartiva.Domain.Invoice
@using System.Globalization
@using Cartiva.Domain.Enums
@using Cartiva.Shared
@{
    ViewData["Title"] = $"Invoice #{Model.InvoiceNumber}";
    var culture = CultureInfo.GetCultureInfo("nb-NO");
    var contact = ViewBag.CartivaContact as dynamic;
    var isPaid = Model.Status == Cartiva.Domain.Enums.InvoiceStatus.Paid;
    var orderId = Model.OrderHeaderId;
    var latestShipment = Model.OrderHeader?.Shipments?.OrderByDescending(s => s.Id).FirstOrDefault();
    var hasCreditNotes = Model.CreditNotes?.Any() == true;
    var statusText = isPaid ? "Paid - this invoice also serves as the payment receipt" : "Deferred / Outstanding";
    var statusHelp = isPaid
        ? $"Paid on {Model.PaidDate?.ToString("dd MMM yyyy") ?? "recorded date unavailable"}."
        : $"Payment is due by {Model.DueDate.ToString("dd MMM yyyy")}.";
}

<div class="container-fluid py-4" style="max-width: 900px;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Invoice #@Model.InvoiceNumber</h2>
            <span class="badge @(Model.Status == Cartiva.Domain.Enums.InvoiceStatus.Paid ? "badge-success" : Model.Status == Cartiva.Domain.Enums.InvoiceStatus.Overdue ? "badge-danger" : "badge-warning") fs-6">@Model.Status</span>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header bg-primary text-white">Invoice Information</div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Order</dt>
                            <dd class="col-sm-8">
                                <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@Model.OrderHeaderId">
                                    #@Model.OrderHeaderId
                                </a>
                            </dd>
                            <dt class="col-sm-4">Customer</dt>
                            <dd class="col-sm-8">@Model.CustomerName</dd>
                            <dt class="col-sm-4">Issue Date</dt>
                            <dd class="col-sm-8">@Model.IssueDate.ToString("dd.MM.yyyy")</dd>
                            <dt class="col-sm-4">Due Date</dt>
                            <dd class="col-sm-8">@Model.DueDate.ToString("dd.MM.yyyy")</dd>
                            <dt class="col-sm-4">Status</dt>
                            <dd class="col-sm-8">@Model.Status</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header bg-success text-white">Amounts</div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-4">Net</dt>
                            <dd class="col-sm-8">@Model.NetAmount.ToString("C", culture)</dd>
                            <dt class="col-sm-4">VAT</dt>
                            <dd class="col-sm-8">@Model.VatAmount.ToString("C", culture)</dd>
                            <dt class="col-sm-4">Total</dt>
                            <dd class="col-sm-8">@Model.TotalAmount.ToString("C", culture)</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3 mb-4">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@Model.OrderHeaderId" class="btn btn-outline-dark">View Order</a>
        </div>
    </div>
</div>

<!-- Printable Invoice Section (Hidden by default, shown for print/PDF) -->
<div class="d-none d-print-block">
    <div class="invoice-container invoice-wrapper">
        @if (isPaid)
        {
            <div class="paid-stamp">PAID</div>
        }

        <div class="header">
            <div class="header-left">
                <div class="invoice-title">INVOICE</div>
                <div class="invoice-number">@Model.InvoiceNumber</div>
                <!-- Status badge removed -->
            </div>
            <div class="header-right">
                <strong>@contact?.Name</strong><br />
                @contact?.Address<br />
                Org. No.: @contact?.OrgNumber<br />
                Tel: @contact?.Phone<br />
                @contact?.Email
            </div>
        </div>

        <div class="info-box" style="margin-bottom: 20px; border-left: 4px solid @(isPaid ? "#27ae60" : "#e67e22");">
            <h4>Invoice Status</h4>
            <p><strong>@statusText</strong></p>
            <p>@statusHelp</p>
        </div>

        <div class="info-grid">
            <div class="info-box">
                <h4>Bill To</h4>
                <p><strong>@Model.CustomerName</strong></p>
                @if (!string.IsNullOrEmpty(Model.CustomerOrgNumber))
                {
                    <p>Org. No.: @Model.CustomerOrgNumber</p>
                }
                <p>@Model.CustomerAddress</p>
                <p>@Model.CustomerEmail</p>
            </div>
            <div class="info-box">
                <h4>Invoice Details</h4>
                <p><strong>Invoice Date:</strong> @Model.IssueDate.ToString("dd.MM.yyyy")</p>
                <p><strong>Due Date:</strong> @Model.DueDate.ToString("dd.MM.yyyy")</p>
                @if (Model.OrderHeaderId.HasValue)
                {
                    <p><strong>Order #:</strong> @Model.OrderHeaderId</p>
                }
                <p><strong>Currency:</strong> @Model.Currency</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="width: 40%">Description</th>
                    <th class="text-right" style="width: 10%">Qty</th>
                    <th class="text-right" style="width: 15%">Unit Price</th>
                    <th class="text-right" style="width: 10%">VAT %</th>
                    <th class="text-right" style="width: 12%">VAT Amount</th>
                    <th class="text-right" style="width: 13%">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines.OrderBy(l => l.SortOrder))
                {
                    <tr>
                        <td>
                            @line.ProductName
                            @if (!string.IsNullOrEmpty(line.ProductDescription))
                            {
                                <br /><small style="color: #7f8c8d;">@line.ProductDescription</small>
                            }
                        </td>
                        <td class="text-right">@line.Quantity</td>
                        <td class="text-right">@line.UnitPrice.ToString("N2", culture)</td>
                        <td class="text-right">@line.VatPercent.ToString("N0")%</td>
                        <td class="text-right">@line.LineVatAmount.ToString("N2", culture)</td>
                        <td class="text-right">@line.LineTotalAmount.ToString("N2", culture)</td>
                    </tr>
                }
            </tbody>
            }</td>

            <div class="totals-section">
                <table class="totals-table">
                    <tr>
                        <td>Subtotal (excl. VAT):</td>
                        <td class="text-right">@Model.NetAmount.ToString("C", culture)</td>
                    </tr>
                    <tr>
                        <td>VAT:</td>
                        <td class="text-right">@Model.VatAmount.ToString("C", culture)</td>
                    </tr>
                    <tr class="total-row">
                        <td>Total:</td>
                        <td class="text-right">@Model.TotalAmount.ToString("C", culture)</td>
                    </tr>
                    @if (Model.TotalPaid > 0)
                    {
                        <tr>
                            <td style="color: #27ae60;">Paid:</td>
                            <td class="text-right" style="color: #27ae60;">-@Model.TotalPaid.ToString("C", culture)</td>
                        </tr>
                        <tr class="total-row">
                            <td>Balance Due:</td>
                            <td class="text-right">@Model.RemainingAmount.ToString("C", culture)</td>
                        </tr>
                    }
                </table>
            </div>

            @if (!isPaid && Model.RemainingAmount > 0)
            {
                <div class="payment-details">
                    <h4>Payment Information</h4>
                    <div class="payment-grid">
                        <div class="payment-item">
                            <label>Due Date:</label>
                            <span>@Model.DueDate.ToString("dd.MM.yyyy")</span>
                        </div>
                        <div class="payment-item">
                            <label>Amount Due:</label>
                            <span>@Model.RemainingAmount.ToString("C", culture)</span>
                        </div>
                        <div class="payment-item">
                            <label>Bank Account:</label>
                            <span>@(Model.BankAccountNumber ?? "N/A")</span>
                        </div>
                        <div class="payment-item">
                            <label>KID Number:</label>
                            <span class="kid-number">@Model.KID</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.IBAN))
                        {
                            <div class="payment-item">
                                <label>IBAN:</label>
                                <span>@Model.IBAN</span>
                            </div>
                            <div class="payment-item">
                                <label>BIC/SWIFT:</label>
                                <span>@Model.BIC</span>
                            </div>
                        }
                    </div>
                    <p style="margin-top: 15px; font-style: italic; color: #7f8c8d;">
                        Please use the KID number when making payment to ensure correct registration.
                    </p>
                </div>
            }

            @if (Model.Payments?.Any() == true)
            {
                <div class="payments-history">
                    <h4>Payment History</h4>
                    <table style="margin: 0;">
                        <thead>
                            <tr style="background: #27ae60;">
                                <th>Date</th>
                                <th>Method</th>
                                <th>Reference</th>
                                <th class="text-right">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.Payments.OrderBy(p => p.PaymentDate))
                            {
                                <tr>
                                    <td>@payment.PaymentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@payment.PaymentMethod</td>
                                    <td>@(payment.PaymentReference ?? payment.TransactionId ?? "-")</td>
                                    <td class="text-right">@payment.Amount.ToString("C", culture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="footer">
                <p>This is an electronic invoice – no physical copy will be sent.</p>
                <p>Late payment may incur interest and collection fees in accordance with Norwegian law.</p>
                <p style="margin-top: 10px;">
                    <strong>@contact?.Name</strong> | Org.nr: @contact?.OrgNumber | @contact?.Email
                </p>
            </div>

            <div class="no-print" style="text-align: center; margin-top: 30px;">
                <form asp-area="Admin" asp-controller="Invoice" asp-action="Send" asp-route-id="@Model.Id" method="post" style="display:inline-block; margin-right:10px;">
                    <button type="submit" style="padding: 10px 30px; font-size: 16px; background: #27ae60; color: white; border: none; border-radius: 5px; cursor: pointer;">
                        Send Invoice Email
                    </button>
                </form>
                @if (orderId.HasValue)
                {
                    <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@orderId.Value" style="display:inline-block; padding: 10px 30px; font-size: 16px; background: #2c3e50; color: white; text-decoration:none; border-radius: 5px; margin-right: 10px;">
                        View Order
                    </a>
                }
                @if (latestShipment != null)
                {
                    <a asp-area="Admin" asp-controller="Shipment" asp-action="Details" asp-route-id="@latestShipment.Id" style="display:inline-block; padding: 10px 30px; font-size: 16px; background: #8e44ad; color: white; text-decoration:none; border-radius: 5px; margin-right: 10px;">
                        View Shipment
                    </a>
                }
                @if (hasCreditNotes)
                {
                    <a asp-area="Admin" asp-controller="CreditNote" asp-action="Index" asp-route-invoiceId="@Model.Id" style="display:inline-block; padding: 10px 30px; font-size: 16px; background: #16a085; color: white; text-decoration:none; border-radius: 5px; margin-right: 10px;">
                        View Credit Notes
                    </a>
                }
                <button onclick="window.print()" style="padding: 10px 30px; font-size: 16px; background: #3498db; color: white; border: none; border-radius: 5px; cursor: pointer; margin-right: 10px;">
                    Print / Save PDF
                </button>
                <button onclick="window.close()" style="padding: 10px 30px; font-size: 16px; background: #95a5a6; color: white; border: none; border-radius: 5px; cursor: pointer;">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

