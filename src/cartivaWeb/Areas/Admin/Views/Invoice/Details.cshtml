@model Cartiva.Domain.Invoice
@using System.Globalization
@using Cartiva.Shared
@{
    Layout = null;
    var culture = CultureInfo.GetCultureInfo("nb-NO");
    var contact = ViewBag.CartivaContact as dynamic;
    var isPaid = Model.Status == Cartiva.Domain.InvoiceStatus.Paid;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice @Model.InvoiceNumber</title>
    <style>
            body {
                font-family: 'Segoe UI', Arial, sans-serif;
                margin: 40px;
                color: #333;
                font-size: 14px;
            }

            .invoice-container {
                max-width: 800px;
                margin: 0 auto;
                border: 1px solid #ddd;
                padding: 30px;
                border-radius: 8px;
            }

            .header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                margin-bottom: 30px;
                border-bottom: 2px solid #2c3e50;
                padding-bottom: 20px;
            }

            .header-left {
                flex: 1;
            }

            .header-right {
                text-align: right;
            }

            .invoice-title {
                font-size: 28px;
                font-weight: bold;
                color: #2c3e50;
                margin-bottom: 5px;
            }

            .invoice-number {
                font-size: 16px;
                color: #7f8c8d;
            }

            /* Status badge styles removed as requested */

            .info-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 30px;
                margin-bottom: 30px;
            }

            .info-box {
                padding: 15px;
                background: #f8f9fa;
                border-radius: 8px;
            }

                .info-box h4 {
                    margin: 0 0 10px 0;
                    color: #2c3e50;
                    font-size: 12px;
                    text-transform: uppercase;
                    letter-spacing: 1px;
                }

                .info-box p {
                    margin: 5px 0;
                    line-height: 1.6;
                }

            table {
                width: 100%;
                border-collapse: collapse;
                margin: 20px 0;
            }

            th {
                background-color: #2c3e50;
                color: white;
                padding: 12px 8px;
                text-align: left;
                font-weight: 500;
            }

            td {
                border-bottom: 1px solid #ddd;
                padding: 12px 8px;
            }

            .text-right {
                text-align: right;
            }

            .totals-section {
                display: flex;
                justify-content: flex-end;
                margin-top: 20px;
            }

            .totals-table {
                width: 300px;
            }

                .totals-table td {
                    padding: 8px;
                    border: none;
                }

                .totals-table .total-row {
                    font-weight: bold;
                    font-size: 18px;
                    border-top: 2px solid #2c3e50;
                }

            .payment-details {
                margin-top: 30px;
                padding: 20px;
                background: #f0f7ff;
                border-left: 4px solid #3498db;
                border-radius: 4px;
            }

                .payment-details h4 {
                    margin: 0 0 15px 0;
                    color: #2c3e50;
                }

            .payment-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .payment-item {
                display: flex;
                justify-content: space-between;
            }

                .payment-item label {
                    font-weight: 500;
                    color: #7f8c8d;
                }

                .payment-item span {
                    font-weight: bold;
                }

            .kid-number {
                font-family: 'Courier New', monospace;
                font-size: 18px;
                letter-spacing: 2px;
                background: #fff;
                padding: 8px 12px;
                border-radius: 4px;
                border: 1px dashed #3498db;
            }

            .paid-stamp {
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%) rotate(-30deg);
                font-size: 72px;
                font-weight: bold;
                color: rgba(39, 174, 96, 0.2);
                text-transform: uppercase;
                pointer-events: none;
                z-index: 1;
            }

            .invoice-wrapper {
                position: relative;
            }

            .footer {
                margin-top: 40px;
                padding-top: 20px;
                border-top: 1px solid #ddd;
                font-size: 12px;
                text-align: center;
                color: #7f8c8d;
            }

            .payments-history {
                margin-top: 20px;
                padding: 15px;
                background: #e8f5e9;
                border-radius: 8px;
            }

                .payments-history h4 {
                    margin: 0 0 10px 0;
                    color: #27ae60;
                }

            @@media print {
                body {
                    margin: 0;
                }

                .no-print {
                    display: none;
                }

                .invoice-container {
                    border: none;
                    padding: 0;
                }
            }
    </style>
</head>
<body>
    <div class="invoice-container invoice-wrapper">
        @if (isPaid)
        {
            <div class="paid-stamp">PAID</div>
        }

        <div class="header">
            <div class="header-left">
                <div class="invoice-title">INVOICE</div>
                <div class="invoice-number">@Model.InvoiceNumber</div>
                <!-- Status badge removed -->
            </div>
            <div class="header-right">
                <strong>@contact?.Name</strong><br />
                @contact?.Address<br />
                Org.nr: @contact?.OrgNumber<br />
                Tel: @contact?.Phone<br />
                @contact?.Email
            </div>
        </div>

        <div class="info-grid">
            <div class="info-box">
                <h4>Bill To</h4>
                <p><strong>@Model.CustomerName</strong></p>
                @if (!string.IsNullOrEmpty(Model.CustomerOrgNumber))
                {
                    <p>Org.nr: @Model.CustomerOrgNumber</p>
                }
                <p>@Model.CustomerAddress</p>
                <p>@Model.CustomerEmail</p>
            </div>
            <div class="info-box">
                <h4>Invoice Details</h4>
                <p><strong>Invoice Date:</strong> @Model.IssueDate.ToString("dd.MM.yyyy")</p>
                <p><strong>Due Date:</strong> @Model.DueDate.ToString("dd.MM.yyyy")</p>
                @if (Model.OrderHeaderId.HasValue)
                {
                    <p><strong>Order #:</strong> @Model.OrderHeaderId</p>
                }
                <p><strong>Currency:</strong> @Model.Currency</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="width: 40%">Description</th>
                    <th class="text-right" style="width: 10%">Qty</th>
                    <th class="text-right" style="width: 15%">Unit Price</th>
                    <th class="text-right" style="width: 10%">VAT %</th>
                    <th class="text-right" style="width: 12%">VAT Amount</th>
                    <th class="text-right" style="width: 13%">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines.OrderBy(l => l.SortOrder))
                {
                    <tr>
                        <td>
                            @line.ProductName
                            @if (!string.IsNullOrEmpty(line.ProductDescription))
                            {
                                <br /><small style="color: #7f8c8d;">@line.ProductDescription</small>
                            }
                        </td>
                        <td class="text-right">@line.Quantity</td>
                        <td class="text-right">@line.UnitPrice.ToString("N2", culture)</td>
                        <td class="text-right">@line.VatPercent.ToString("N0")%</td>
                        <td class="text-right">@line.LineVatAmount.ToString("N2", culture)</td>
                        <td class="text-right">@line.LineTotalAmount.ToString("N2", culture)</td>
                    </tr>
                }
            </tbody>
            }</td>

            <div class="totals-section">
                <table class="totals-table">
                    <tr>
                        <td>Subtotal (excl. VAT):</td>
                        <td class="text-right">@Model.NetAmount.ToString("C", culture)</td>
                    </tr>
                    <tr>
                        <td>VAT (MVA):</td>
                        <td class="text-right">@Model.VatAmount.ToString("C", culture)</td>
                    </tr>
                    <tr class="total-row">
                        <td>Total:</td>
                        <td class="text-right">@Model.TotalAmount.ToString("C", culture)</td>
                    </tr>
                    @if (Model.TotalPaid > 0)
                    {
                        <tr>
                            <td style="color: #27ae60;">Paid:</td>
                            <td class="text-right" style="color: #27ae60;">-@Model.TotalPaid.ToString("C", culture)</td>
                        </tr>
                        <tr class="total-row">
                            <td>Balance Due:</td>
                            <td class="text-right">@Model.RemainingAmount.ToString("C", culture)</td>
                        </tr>
                    }
                </table>
            </div>

            @if (!isPaid && Model.RemainingAmount > 0)
            {
                <div class="payment-details">
                    <h4>Payment Information</h4>
                    <div class="payment-grid">
                        <div class="payment-item">
                            <label>Due Date:</label>
                            <span>@Model.DueDate.ToString("dd.MM.yyyy")</span>
                        </div>
                        <div class="payment-item">
                            <label>Amount Due:</label>
                            <span>@Model.RemainingAmount.ToString("C", culture)</span>
                        </div>
                        <div class="payment-item">
                            <label>Bank Account:</label>
                            <span>@(Model.BankAccountNumber ?? "N/A")</span>
                        </div>
                        <div class="payment-item">
                            <label>KID Number:</label>
                            <span class="kid-number">@Model.KID</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.IBAN))
                        {
                            <div class="payment-item">
                                <label>IBAN:</label>
                                <span>@Model.IBAN</span>
                            </div>
                            <div class="payment-item">
                                <label>BIC/SWIFT:</label>
                                <span>@Model.BIC</span>
                            </div>
                        }
                    </div>
                    <p style="margin-top: 15px; font-style: italic; color: #7f8c8d;">
                        Please use the KID number when making payment to ensure correct registration.
                    </p>
                </div>
            }

            @if (Model.Payments?.Any() == true)
            {
                <div class="payments-history">
                    <h4>Payment History</h4>
                    <table style="margin: 0;">
                        <thead>
                            <tr style="background: #27ae60;">
                                <th>Date</th>
                                <th>Method</th>
                                <th>Reference</th>
                                <th class="text-right">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.Payments.OrderBy(p => p.PaymentDate))
                            {
                                <tr>
                                    <td>@payment.PaymentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@payment.PaymentMethod</td>
                                    <td>@(payment.PaymentReference ?? payment.TransactionId ?? "-")</td>
                                    <td class="text-right">@payment.Amount.ToString("C", culture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="footer">
                <p>This is an electronic invoice – no physical copy will be sent.</p>
                <p>Late payment may incur interest and collection fees in accordance with Norwegian law.</p>
                <p style="margin-top: 10px;">
                    <strong>@contact?.Name</strong> | Org.nr: @contact?.OrgNumber | @contact?.Email
                </p>
            </div>

            <div class="no-print" style="text-align: center; margin-top: 30px;">
                <button onclick="window.print()" style="padding: 10px 30px; font-size: 16px; background: #3498db; color: white; border: none; border-radius: 5px; cursor: pointer; margin-right: 10px;">
                    Print / Save PDF
                </button>
                <button onclick="window.close()" style="padding: 10px 30px; font-size: 16px; background: #95a5a6; color: white; border: none; border-radius: 5px; cursor: pointer;">
                    Close
                </button>
            </div>
        </div>
    </body>
</html>