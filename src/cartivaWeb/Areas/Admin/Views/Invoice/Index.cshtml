@model InvoiceDashboardViewModel
@using System.Globalization
@using Cartiva.Application.Extensions
@using Cartiva.Domain.Enums
@using Cartiva.Domain.Extensions
@{
    ViewData["Title"] = "Invoice Management";
    var culture = CultureInfo.GetCultureInfo("nb-NO");
}

@section Styles {
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <!-- Shared Admin Dashboard CSS -->
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <!-- Invoice-specific CSS (extends admin-dashboard) -->
    <link rel="stylesheet" href="~/css/invoice.css" asp-append-version="true" />
}

<div class="admin-dashboard">
    <div class="container-fluid">
        <h2><i class="bi bi-receipt"></i> Invoice Management</h2>
        <div class="row mb-4 g-3">
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-warning">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-exclamation-triangle-fill"></i> Overdue</h5>
                        <h3>@Model.OverdueCount</h3>
                        <p class="mb-1">@Model.TotalOverdue.ToString("C", culture)</p>
                        <small>Ex VAT: @Model.TotalOverdueExVat.ToString("C", culture)</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-info">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-clock-fill"></i> Pending</h5>
                        <h3>@Model.PendingCount</h3>
                        <p class="mb-1">@Model.TotalPending.ToString("C", culture)</p>
                        <small>Ex VAT: @Model.TotalPendingExVat.ToString("C", culture)</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-success">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-check-circle-fill"></i> Paid</h5>
                        <h3>@Model.PaidCount</h3>
                        <p class="mb-1">@Model.TotalPaid.ToString("C", culture)</p>
                        <small>Ex VAT: @Model.TotalPaidExVat.ToString("C", culture)</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card admin-card card-danger">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-cash-stack"></i> Total Outstanding</h5>
                        <h3>@Model.TotalOutstanding.ToString("C", culture)</h3>
                        <small>Ex VAT: @Model.TotalOutstandingExVat.ToString("C", culture)</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Overdue Invoices Section -->
        <div class="invoice-section section-overdue">
            <h3><i class="bi bi-exclamation-triangle"></i> Overdue Invoices</h3>
            @if (!Model.OverdueInvoices.Any() && !Model.OverdueInvoiceEntities.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-check-circle"></i>
                    <p>No overdue invoices - Great job!</p>
                </div>
            }
            else
            {
                <table id="overdueTable" class="table invoice-table table-overdue">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Order</th>
                            <th>Company</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Ex VAT</th>
                            <th>VAT</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model.OverdueInvoiceEntities)
                        {
                            <tr>
                                <td>@invoice.InvoiceNumber</td>
                                <td>
                                    @if (invoice.OrderHeaderId.HasValue)
                                    {
                                        <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@invoice.OrderHeaderId.Value">
                                            #@invoice.OrderHeaderId.Value
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@(invoice.OrderHeader?.ApplicationUser?.Company?.Name ?? "-")</td>
                                <td>@invoice.CustomerName</td>
                                <td>
                                    <span class="badge @invoice.Status.GetBadgeClass()">@invoice.Status</span>
                                </td>
                                <td class="text-overdue">@invoice.DueDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">@invoice.NetAmount.ToString("N2", culture)</td>
                                <td class="text-end text-muted-light">@invoice.VatAmount.ToString("N2", culture)</td>
                                <td class="text-end amount-large">@invoice.RemainingAmount.ToString("C", culture)</td>
                                <td class="action-buttons">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-area="Admin" asp-controller="Invoice" asp-action="PrintInvoice" asp-route-id="@invoice.Id" target="_blank" class="btn btn-sm btn-secondary" title="Print Invoice">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        @if (invoice.OrderHeaderId.HasValue)
                                        {
                                            <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@invoice.OrderHeaderId.Value" class="btn btn-sm btn-outline-primary" title="View Order">
                                                <i class="bi bi-bag"></i>
                                            </a>
                                        }
                                        @if (!invoice.SentDate.HasValue)
                                        {
                                            <form asp-action="Send" asp-route-id="@invoice.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary" title="Send Invoice">
                                                    <i class="bi bi-envelope"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check"></i> Sent</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                        @foreach (var order in Model.OverdueInvoices)
                        {
                            var exVat = order.SubtotalExVat > 0 ? order.SubtotalExVat : order.OrderTotal / 1.25m;
                            var vat = order.TotalVatAmount > 0 ? order.TotalVatAmount : order.OrderTotal - exVat;
                            <tr>
                                <td><span class="text-muted">Generate on send</span></td>
                                <td><span>#@order.Id</span></td>
                                <td>@(order.ApplicationUser?.Company?.Name ?? "-")</td>
                                <td>@(order.ApplicationUser?.Name ?? order.Name)</td>
                                <td><span class="badge bg-danger">Outstanding</span></td>
                                <td class="text-overdue">@order.PaymentDueDate?.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">@exVat.ToString("N2", culture)</td>
                                <td class="text-end text-muted-light">@vat.ToString("N2", culture)</td>
                                <td class="text-end amount-large">@order.OrderTotal.ToString("C", culture)</td>
                                <td class="action-buttons">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-area="Admin" asp-controller="Invoice" asp-action="PrintInvoice" asp-route-id="@order.Id" target="_blank" class="btn btn-sm btn-secondary" title="Print Invoice">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@order.Id" class="btn btn-sm btn-outline-primary" title="View Order">
                                            <i class="bi bi-bag"></i>
                                        </a>
                                        @if (!order.InvoiceSent)
                                        {
                                            <form asp-action="Send" asp-route-id="@order.Id" method="post" class="d-inline" data-confirm="Send reminder to customer?">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary" title="Send Reminder">
                                                    <i class="bi bi-envelope"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check"></i> Sent</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end fw-bold">Total Overdue:</td>
                            <td class="text-end fw-bold">@Model.TotalOverdueExVat.ToString("N2", culture)</td>
                            <td class="text-end text-muted-light">@Model.TotalOverdueVat.ToString("N2", culture)</td>
                            <td class="text-end fw-bold">@Model.TotalOverdue.ToString("C", culture)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>

        <!-- Pending Invoices Section -->
        <div class="invoice-section section-pending">
            <h3><i class="bi bi-clock"></i> Pending Invoices (Not yet due)</h3>
            @if (!Model.PendingInvoices.Any() && !Model.PendingInvoiceEntities.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>No pending invoices</p>
                </div>
            }
            else
            {
                <table id="pendingTable" class="table invoice-table table-pending">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Order</th>
                            <th>Company</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Ex VAT</th>
                            <th>VAT</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model.PendingInvoiceEntities)
                        {
                            var statusLabel = invoice.Status == InvoiceStatus.Paid ? "Paid" : "Deferred / Outstanding";
                            <tr>
                                <td>@invoice.InvoiceNumber</td>
                                <td>
                                    @if (invoice.OrderHeaderId.HasValue)
                                    {
                                        <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@invoice.OrderHeaderId.Value">
                                            #@invoice.OrderHeaderId.Value
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@(invoice.OrderHeader?.ApplicationUser?.Company?.Name ?? "-")</td>
                                <td>@invoice.CustomerName</td>
                                <td>
                                    <span class="badge @invoice.Status.GetBadgeClass()">@statusLabel</span>
                                </td>
                                <td>@invoice.DueDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">@invoice.NetAmount.ToString("N2", culture)</td>
                                <td class="text-end text-muted-light">@invoice.VatAmount.ToString("N2", culture)</td>
                                <td class="text-end amount-large">@invoice.RemainingAmount.ToString("C", culture)</td>
                                <td class="action-buttons">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-area="Admin" asp-controller="Invoice" asp-action="PrintInvoice" asp-route-id="@invoice.Id" target="_blank" class="btn btn-sm btn-secondary" title="Print Invoice">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        @if (invoice.OrderHeaderId.HasValue)
                                        {
                                            <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@invoice.OrderHeaderId.Value" class="btn btn-sm btn-outline-primary" title="View Order">
                                                <i class="bi bi-bag"></i>
                                            </a>
                                        }
                                        <form asp-action="Send" asp-route-id="@invoice.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary" title="Send Invoice">
                                                <i class="bi bi-envelope"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                        @foreach (var order in Model.PendingInvoices)
                        {
                            var exVat = order.SubtotalExVat > 0 ? order.SubtotalExVat : order.OrderTotal / 1.25m;
                            var vat = order.TotalVatAmount > 0 ? order.TotalVatAmount : order.OrderTotal - exVat;
                            <tr>
                                <td><span class="text-muted">Generate on send</span></td>
                                <td><span>#@order.Id</span></td>
                                <td>@(order.ApplicationUser?.Company?.Name ?? "-")</td>
                                <td>@(order.ApplicationUser?.Name ?? order.Name)</td>
                                <td><span class="badge bg-info">Deferred / Outstanding</span></td>
                                <td>@order.PaymentDueDate?.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">@exVat.ToString("N2", culture)</td>
                                <td class="text-end text-muted-light">@vat.ToString("N2", culture)</td>
                                <td class="text-end amount-large">@order.OrderTotal.ToString("C", culture)</td>
                                <td class="action-buttons">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-area="Admin" asp-controller="Invoice" asp-action="PrintInvoice" asp-route-id="@order.Id" target="_blank" class="btn btn-sm btn-secondary" title="Print Invoice">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        <form asp-action="Send" asp-route-id="@order.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary" title="Send Invoice">
                                                <i class="bi bi-envelope"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end fw-bold">Total Pending:</td>
                            <td class="text-end fw-bold">@Model.TotalPendingExVat.ToString("N2", culture)</td>
                            <td class="text-end text-muted-light">@Model.TotalPendingVat.ToString("N2", culture)</td>
                            <td class="text-end fw-bold">@Model.TotalPending.ToString("C", culture)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>

        <!-- Paid Invoices Section -->
        <div class="invoice-section section-paid">
            <h3><i class="bi bi-check-circle"></i> Paid Invoices</h3>
            @if (!Model.PaidInvoices.Any() && !Model.PaidInvoiceEntities.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>No paid invoices yet</p>
                </div>
            }
            else
            {
                <table id="paidTable" class="table invoice-table table-paid">
                    <thead>
                        <tr>
                            <th>Invoice</th>
                            <th>Order</th>
                            <th>Company</th>
                            <th>Customer</th>
                            <th>Status</th>
                            <th>Payment Date</th>
                            <th>Ex VAT</th>
                            <th>VAT</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in Model.PaidInvoiceEntities)
                        {
                            <tr>
                                <td>@invoice.InvoiceNumber</td>
                                <td>
                                    @if (invoice.OrderHeaderId.HasValue)
                                    {
                                        <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@invoice.OrderHeaderId.Value">
                                            #@invoice.OrderHeaderId.Value
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@(invoice.OrderHeader?.ApplicationUser?.Company?.Name ?? "-")</td>
                                <td>@invoice.CustomerName</td>
                                <td><span class="badge @invoice.Status.GetBadgeClass()">Paid</span></td>
                                <td class="amount-positive">@invoice.PaidDate?.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">@invoice.NetAmount.ToString("N2", culture)</td>
                                <td class="text-end text-muted-light">@invoice.VatAmount.ToString("N2", culture)</td>
                                <td class="text-end amount-large amount-positive">@invoice.TotalAmount.ToString("C", culture)</td>
                                <td class="action-buttons">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-area="Admin" asp-controller="Invoice" asp-action="PrintInvoice" asp-route-id="@invoice.Id" target="_blank" class="btn btn-sm btn-secondary" title="Print Invoice">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        @if (invoice.OrderHeaderId.HasValue)
                                        {
                                            <a asp-area="Admin" asp-controller="Order" asp-action="Details" asp-route-orderId="@invoice.OrderHeaderId.Value" class="btn btn-sm btn-outline-primary" title="View Order">
                                                <i class="bi bi-bag"></i>
                                            </a>
                                        }
                                        <form asp-action="Send" asp-route-id="@invoice.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary" title="Send Invoice">
                                                <i class="bi bi-envelope"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                        @foreach (var order in Model.PaidInvoices)
                        {
                            var exVat = order.SubtotalExVat > 0 ? order.SubtotalExVat : order.OrderTotal / 1.25m;
                            var vat = order.TotalVatAmount > 0 ? order.TotalVatAmount : order.OrderTotal - exVat;
                            <tr>
                                <td><span class="text-muted">Generate on send</span></td>
                                <td><span>#@order.Id</span></td>
                                <td>@(order.ApplicationUser?.Company?.Name ?? "-")</td>
                                <td>@(order.ApplicationUser?.Name ?? order.Name)</td>
                                <td><span class="badge bg-success">Paid</span></td>
                                <td class="amount-positive">@order.PaymentDate?.ToString("dd.MM.yyyy")</td>
                                <td class="text-end">@exVat.ToString("N2", culture)</td>
                                <td class="text-end text-muted-light">@vat.ToString("N2", culture)</td>
                                <td class="text-end amount-large amount-positive">@order.OrderTotal.ToString("C", culture)</td>
                                <td class="action-buttons">
                                    <div class="d-flex gap-1 flex-wrap">
                                        <a asp-area="Admin" asp-controller="Invoice" asp-action="PrintInvoice" asp-route-id="@order.Id" target="_blank" class="btn btn-sm btn-secondary" title="Print Invoice">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        <form asp-action="Send" asp-route-id="@order.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-primary" title="Send Invoice Receipt">
                                                <i class="bi bi-envelope"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end fw-bold">Total Paid:</td>
                            <td class="text-end fw-bold">@Model.TotalPaidExVat.ToString("N2", culture)</td>
                            <td class="text-end text-muted-light">@Model.TotalPaidVat.ToString("N2", culture)</td>
                            <td class="text-end fw-bold amount-positive">@Model.TotalPaid.ToString("C", culture)</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <!-- Invoice Dashboard JS -->
    <script src="~/js/invoice.js" asp-append-version="true"></script>
}