@model Cartiva.Infrastructure.Templates.Models.OrderConfirmationModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Order Confirmation</title>
</head>
<body>
    <p>Hello @Model.Name,</p>
    <p>Thank you for your order.</p>
    <p><strong>Order Number:</strong> @Model.OrderId</p>
    <p><strong>Order Date:</strong> @Model.OrderDate</p>
    <p><strong>Total Amount:</strong> @Model.TotalAmount</p>
</body>
</html>
