@model Cartiva.Infrastructure.Notifications.Templates.Models.WelcomeEmailModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Cartiva</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #673AB7;
            color: white;
            padding: 30px 20px;
            text-align: center;
        }
        .content {
            padding: 20px;
            background-color: #f9f9f9;
        }
        .feature-box {
            background-color: white;
            padding: 15px;
            margin: 15px 0;
            border-radius: 5px;
            border-left: 4px solid #673AB7;
        }
        .footer {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #666;
        }
        .button {
            display: inline-block;
            padding: 12px 30px;
            background-color: #673AB7;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin: 10px 0;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🎉 Welcome to Cartiva!</h1>
    </div>

    <div class="content">
        <p>Hello @Model.Name,</p>

        <p>Welcome to Cartiva! We're thrilled to have you join our community.</p>

        @if (!string.IsNullOrEmpty(Model.VerificationLink))
        {
            <div class="feature-box">
                <h3>Verify Your Email</h3>
                <p>Please verify your email address to get started:</p>
                <p>
                    <a href="@Model.VerificationLink" class="button">Verify Email Address</a>
                </p>
            </div>
        }

        <div class="feature-box">
            <h3>✨ What's Next?</h3>
            <ul>
                <li>Browse our latest collections</li>
                <li>Set up your profile and preferences</li>
                <li>Save your favorite items</li>
                <li>Get exclusive member offers</li>
            </ul>
        </div>

        <p>If you have any questions or need assistance, our support team is here to help.</p>

        <p>Happy shopping!</p>

        <p>Best regards,<br/>The Cartiva Team</p>
    </div>

    <div class="footer">
        <p>&copy; @DateTime.UtcNow.Year Cartiva AS. All rights reserved.</p>
        <p>Exampleveien 1, 0655 Oslo | <a href="mailto:post@cartiva.no">post@cartiva.no</a></p>
    </div>
</body>
</html>
