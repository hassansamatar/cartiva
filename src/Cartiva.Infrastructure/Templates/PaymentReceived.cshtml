@model Cartiva.Infrastructure.Notifications.Templates.Models.GenericEmailModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Received</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #4CAF50;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .content {
            padding: 20px;
            background-color: #f9f9f9;
        }
        .payment-box {
            background-color: white;
            padding: 20px;
            margin: 20px 0;
            border-radius: 5px;
            border-left: 4px solid #4CAF50;
        }
        .footer {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #666;
        }
        .checkmark {
            font-size: 48px;
            color: #4CAF50;
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="checkmark">✓</div>
        <h1>Payment Received</h1>
    </div>

    <div class="content">
        <p>Thank you! We've received your payment.</p>

        <div class="payment-box">
            <h3>Payment Details</h3>
            <p><strong>Order Number:</strong> @Model.Data["orderNumber"]</p>
            <p><strong>Amount Paid:</strong> @Model.Data["amount"]</p>
            <p><strong>Payment Date:</strong> @Model.Data["paymentDate"]</p>
        </div>

        <p>Your order is now being processed and will be shipped soon. You'll receive a tracking number once your order ships.</p>

        <p>You can view your order details and track its progress at any time.</p>

        <p>Thank you for your business!</p>

        <p>Best regards,<br/>The Cartiva Team</p>
    </div>

    <div class="footer">
        <p>&copy; @DateTime.UtcNow.Year Cartiva AS. All rights reserved.</p>
        <p>Exampleveien 1, 0655 Oslo | <a href="mailto:post@cartiva.no">post@cartiva.no</a></p>
    </div>
</body>
</html>
