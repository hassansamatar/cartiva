@model Cartiva.Infrastructure.Templates.Models.ARAdjustmentNotificationModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Balance Adjustment</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #0d6efd;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .content {
            padding: 20px;
            background-color: #f9f9f9;
        }
        .adjustment-box {
            background-color: white;
            padding: 20px;
            margin: 20px 0;
            border-radius: 5px;
            border-left: 4px solid #0d6efd;
        }
        .footer {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #666;
        }
        .amount-highlight {
            font-size: 24px;
            color: #0d6efd;
            font-weight: bold;
        }
        .info-box {
            background-color: #e7f3ff;
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
        }
        .status-badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }
        .status-applied { background-color: #d4edda; color: #155724; }
        .status-approved { background-color: #cce5ff; color: #004085; }
        .status-pending { background-color: #fff3cd; color: #856404; }
    </style>
</head>
<body>
    <div class="header">
        <h1>📊 Account Receivable Adjustment</h1>
    </div>

    <div class="content">
        <p>Hello <strong>@Model.CompanyName</strong>,</p>

        <p>An adjustment has been applied to your accounts receivable balance with Cartiva.</p>

        <div class="adjustment-box">
            <h3>Adjustment Details</h3>
            <p><strong>Adjustment ID:</strong> @Model.AdjustmentId</p>
            <p><strong>Adjustment Amount:</strong> <span class="amount-highlight">@Model.Amount @Model.Currency</span></p>
            <p><strong>Reason:</strong> @Model.Reason</p>
            <p><strong>Status:</strong> 
                <span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span>
            </p>
            <p><strong>Created Date:</strong> @Model.CreatedAt</p>

            @if (Model.IsApplied && !string.IsNullOrEmpty(Model.AppliedAt))
            {
                <p><strong>Applied to Stripe Credit Balance:</strong> @Model.AppliedAt</p>
            }

            @if (!string.IsNullOrEmpty(Model.InvoiceNumber))
            {
                <p><strong>Related Invoice:</strong> @Model.InvoiceNumber</p>
            }
        </div>

        <div class="info-box">
            <p><strong>Reason for Adjustment:</strong></p>
            <p>@Model.Reason</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div style="background-color: #fff3cd; padding: 15px; border-radius: 5px; margin: 15px 0;">
                <p><strong>Additional Notes:</strong></p>
                <p>@Model.Notes</p>
            </div>
        }

        <p><strong>What this means:</strong></p>
        <p>Your outstanding balance with Cartiva has been adjusted by <strong>@Model.Amount @Model.Currency</strong>.</p>

        @if (Model.IsApplied)
        {
            <p>This adjustment has been applied to your Stripe credit balance and will be automatically reflected in future invoices.</p>
        }
        else
        {
            <p>This adjustment is @Model.Status.ToLower() and will be applied to your Stripe credit balance once approved.</p>
        }

        <p>If you have any questions about this adjustment, please contact our accounting department.</p>
    </div>

    <div class="footer">
        <p>
            <strong>Cartiva E-Commerce</strong><br />
            Accounting Department<br />
            Storgata 1, 0155 Oslo, Norway<br />
            Email: accounting@cartiva.no | Phone: +47 12345678
        </p>
        <p style="color: #999; font-size: 11px;">
            This is an automated email. Please do not reply directly to this message.
        </p>
    </div>
</body>
</html>