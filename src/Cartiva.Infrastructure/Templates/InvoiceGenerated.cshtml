@model Cartiva.Infrastructure.Templates.Models.InvoiceGeneratedModel
@using Cartiva.Domain.Enums

@{
    var isPaid = Model.Status == InvoiceStatus.Paid || Model.RemainingAmount <= 0;
    var headerTitle = isPaid ? "Payment Receipt" : "Invoice Ready";
    var introText = isPaid
        ? $"Thank you. We have received payment for invoice {Model.InvoiceNumber}."
        : $"Your invoice for order #{Model.OrderHeaderId} is ready.";
    var statusText = isPaid
        ? $"Paid on {Model.PaidDate?.ToString("dd MMM yyyy") ?? "the recorded payment date"}"
        : $"Payment due by {Model.DueDate:dd MMM yyyy}";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice Generated</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #607D8B;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .content {
            padding: 20px;
            background-color: #f9f9f9;
        }
        .invoice-box {
            background-color: white;
            padding: 20px;
            margin: 20px 0;
            border-radius: 5px;
            border-left: 4px solid #607D8B;
        }
        .footer {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #666;
        }
        .button {
            display: inline-block;
            padding: 12px 30px;
            background-color: #607D8B;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin: 10px 0;
            font-weight: bold;
        }
        .important {
            background-color: #fff3cd;
            padding: 10px;
            border-radius: 5px;
            margin: 15px 0;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>📄 @headerTitle</h1>
    </div>

    <div class="content">
        <p>Hello @Model.CustomerName,</p>

        <p>@introText</p>

        <div class="invoice-box">
            <h3>Invoice Details</h3>
            <p><strong>Invoice Number:</strong> @Model.InvoiceNumber</p>
            <p><strong>Order Number:</strong> @Model.OrderHeaderId</p>
            <p><strong>Status:</strong> @statusText</p>
            <p><strong>Total Amount:</strong> @Model.TotalAmount.ToString("N2") @Model.Currency</p>
            <p><strong>Issue Date:</strong> @Model.IssueDate.ToString("dd MMM yyyy")</p>
            <p><strong>Due Date:</strong> @Model.DueDate.ToString("dd MMM yyyy")</p>
            <p><strong>KID / Reference:</strong> @Model.KID</p>
            @if (isPaid)
            {
                <p><strong>Amount Paid:</strong> @Model.TotalPaid.ToString("N2") @Model.Currency</p>
            }
            else
            {
                <p><strong>Amount Outstanding:</strong> @Model.RemainingAmount.ToString("N2") @Model.Currency</p>
            }
        </div>

        @if (isPaid)
        {
            <div class="important">
                <strong>Payment received:</strong> This invoice can be kept as your receipt for this order.
            </div>
        }
        else
        {
            <div class="important">
                <strong>Payment due:</strong> Please make sure payment is received by <strong>@Model.DueDate.ToString("dd MMM yyyy")</strong>.
            </div>
        }

        @if (!isPaid)
        {
            <h3>Payment Information</h3>
            <ul>
                <li><strong>Bank Transfer:</strong> Use KID / reference <strong>@Model.KID</strong> for automatic matching</li>
                @if (!string.IsNullOrWhiteSpace(Model.BankAccountNumber))
                {
                    <li><strong>Bank Account:</strong> @Model.BankAccountNumber</li>
                }
                @if (!string.IsNullOrWhiteSpace(Model.IBAN))
                {
                    <li><strong>IBAN:</strong> @Model.IBAN</li>
                }
                @if (!string.IsNullOrWhiteSpace(Model.BIC))
                {
                    <li><strong>BIC / SWIFT:</strong> @Model.BIC</li>
                }
            </ul>
        }

        <p>If you have any questions about this invoice, please contact our billing team.</p>

        <p>Best regards,<br/>The Cartiva Team</p>
    </div>

    <div class="footer">
        <p>&copy; @DateTime.UtcNow.Year Cartiva AS. All rights reserved.</p>
        <p>@(Model.SellerAddress ?? "Cartiva") | <a href="mailto:@(Model.SellerEmail ?? "post@cartiva.no")">@(Model.SellerEmail ?? "post@cartiva.no")</a></p>
    </div>
</body>
</html>
