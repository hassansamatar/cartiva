@model Cartiva.Infrastructure.Notifications.Templates.Models.GenericEmailModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice Generated</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #607D8B;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .content {
            padding: 20px;
            background-color: #f9f9f9;
        }
        .invoice-box {
            background-color: white;
            padding: 20px;
            margin: 20px 0;
            border-radius: 5px;
            border-left: 4px solid #607D8B;
        }
        .footer {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #666;
        }
        .button {
            display: inline-block;
            padding: 12px 30px;
            background-color: #607D8B;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            margin: 10px 0;
            font-weight: bold;
        }
        .important {
            background-color: #fff3cd;
            padding: 10px;
            border-radius: 5px;
            margin: 15px 0;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>📄 Invoice Ready</h1>
    </div>

    <div class="content">
        <p>Hello @Model.Data["customerName"],</p>

        <p>Your invoice is now ready for order <strong>#@Model.Data["orderNumber"]</strong>.</p>

        <div class="invoice-box">
            <h3>Invoice Details</h3>
            <p><strong>Invoice Number:</strong> @Model.Data["invoiceNumber"]</p>
            <p><strong>Order Number:</strong> @Model.Data["orderNumber"]</p>
            <p><strong>Total Amount:</strong> @Model.Data["totalAmount"]</p>
            <p><strong>Due Date:</strong> @Model.Data["dueDate"]</p>
        </div>

        <div class="important">
            <strong>⏰ Payment Due:</strong> Please ensure payment is received by <strong>@Model.Data["dueDate"]</strong> to avoid late fees.
        </div>

        <h3>Payment Methods:</h3>
        <ul>
            <li><strong>Bank Transfer:</strong> Use KID number on invoice for automatic matching</li>
            <li><strong>Online Payment:</strong> Log in to your account to pay online</li>
        </ul>

        <p>
            <a href="https://cartiva.no/invoices/@Model.Data["invoiceNumber"]" class="button">View & Download Invoice</a>
        </p>

        <p>If you have any questions about this invoice, please contact our billing department.</p>

        <p>Best regards,<br/>The Cartiva Team</p>
    </div>

    <div class="footer">
        <p>&copy; @DateTime.UtcNow.Year Cartiva AS. All rights reserved.</p>
        <p>Exampleveien 1, 0655 Oslo | <a href="mailto:post@cartiva.no">post@cartiva.no</a></p>
    </div>
</body>
</html>
