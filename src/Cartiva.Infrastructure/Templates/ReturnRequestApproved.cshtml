@model Cartiva.Infrastructure.Templates.Models.ReturnRequestApprovedModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Return Request Approved</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #4CAF50;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .content {
            padding: 20px;
            background-color: #f9f9f9;
        }
        .approval-box {
            background-color: #d4edda;
            border-left: 4px solid #28a745;
            padding: 15px;
            margin: 20px 0;
        }
        .footer {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #666;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>✓ Return Approved</h1>
    </div>

    <div class="content">
        <p>Good news! Your return request has been approved.</p>

        <div class="approval-box">
            <h3>Return Details</h3>
            <p><strong>Order Number:</strong> @Model.OrderHeaderId</p>
            <p><strong>Product:</strong> @Model.ProductName</p>
            <p><strong>Refund Amount:</strong> @Model.RefundAmount</p>
            @if (!string.IsNullOrEmpty(Model.AdminNote))
            {
                <p><strong>Note:</strong> @Model.AdminNote</p>
            }
        </div>

        <h3>Next Steps:</h3>
        <ol>
            <li>Pack the item securely in its original packaging if possible</li>
            <li>Include all original accessories and documentation</li>
            <li>Ship the item to the return address provided separately</li>
            <li>Keep your tracking number for reference</li>
        </ol>

        <p><strong>Refund Processing:</strong> Once we receive and inspect the returned item, we'll process your refund within 5-10 business days.</p>

        <p>If you have any questions, please contact our customer service team.</p>

        <p>Best regards,<br/>The Cartiva Team</p>
    </div>

    <div class="footer">
        <p>&copy; @DateTime.UtcNow.Year Cartiva AS. All rights reserved.</p>
        <p>Exampleveien 1, 0655 Oslo | <a href="mailto:post@cartiva.no">post@cartiva.no</a></p>
    </div>
</body>
</html>
