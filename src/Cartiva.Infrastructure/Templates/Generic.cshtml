@model Cartiva.Infrastructure.Notifications.Templates.Models.GenericEmailModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Subject</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #607D8B;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .content {
            padding: 20px;
            background-color: #f9f9f9;
        }
        .message-box {
            background-color: white;
            padding: 20px;
            margin: 20px 0;
            border-radius: 5px;
        }
        .footer {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #666;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>@Model.Subject</h1>
    </div>

    <div class="content">
        <div class="message-box">
            @Html.Raw(Model.Body)
        </div>

        <p>Best regards,<br/>The Cartiva Team</p>
    </div>

    <div class="footer">
        <p>&copy; @DateTime.UtcNow.Year Cartiva AS. All rights reserved.</p>
        <p>Exampleveien 1, 0655 Oslo | <a href="mailto:post@cartiva.no">post@cartiva.no</a></p>
    </div>
</body>
</html>
