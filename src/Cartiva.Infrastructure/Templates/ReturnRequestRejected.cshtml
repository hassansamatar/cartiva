@model Cartiva.Infrastructure.Notifications.Templates.Models.GenericEmailModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Return Request Update</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #FF9800;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .content {
            padding: 20px;
            background-color: #f9f9f9;
        }
        .rejection-box {
            background-color: #fff3cd;
            border-left: 4px solid #ffc107;
            padding: 15px;
            margin: 20px 0;
        }
        .footer {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: #666;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Return Request Update</h1>
    </div>

    <div class="content">
        <p>We've reviewed your return request for order <strong>#@Model.Data["orderNumber"]</strong>.</p>

        <div class="rejection-box">
            <h3>Return Request Details</h3>
            <p><strong>Product:</strong> @Model.Data["productName"]</p>
            <p><strong>Status:</strong> Unable to approve at this time</p>
            <p><strong>Reason:</strong> @Model.Data["reason"]</p>
        </div>

        <p>Unfortunately, we're unable to approve this return request based on our return policy guidelines.</p>

        <h3>Common Reasons for Rejection:</h3>
        <ul>
            <li>Return window has expired (30 days from delivery)</li>
            <li>Item shows signs of use beyond inspection</li>
            <li>Original packaging or accessories are missing</li>
            <li>Item is not in resalable condition</li>
        </ul>

        <p>If you believe this decision was made in error or have additional information to provide, please contact our customer service team. We're here to help resolve any concerns.</p>

        <p>Best regards,<br/>The Cartiva Team</p>
    </div>

    <div class="footer">
        <p>&copy; @DateTime.UtcNow.Year Cartiva AS. All rights reserved.</p>
        <p>Exampleveien 1, 0655 Oslo | <a href="mailto:post@cartiva.no">post@cartiva.no</a> | +47 123 45 688</p>
    </div>
</body>
</html>
